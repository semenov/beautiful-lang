# The classic.

fn label(n: Int) -> Text
  if n % 15 == 0
    return "FizzBuzz"
  if n % 3 == 0
    return "Fizz"
  if n % 5 == 0
    return "Buzz"
  return "{n}"

test "labels"
  expect label(9) == "Fizz"
  expect label(30) == "FizzBuzz"
  expect label(7) == "7"

for n in 1..=100
  print(label(n))
