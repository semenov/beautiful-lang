// markdown: Markdown to HTML, written in the language itself.
//
//   let html = markdown.to_html(text)
//
// CommonMark's basics: headings (# and underlined), paragraphs, **strong**,
// *emphasis*, `code`, fenced and indented code blocks, links, images,
// <autolinks>, lists (nested, numbered), block quotes, rules, hard line
// breaks, backslash escapes; and GitHub's additions: tables,
// ~~strikethrough~~ and bare https:// links.
//
// Safe for text users wrote: raw HTML in the input is shown as text, not
// run, and javascript: links are dropped.
//
// Install: lang add markdown https://github.com/semenov/beautiful-lang --path packages/markdown

pub fn to_html(text: String) -> String {
  let lines = text.replace("\r\n", "\n").replace("\t", "    ").split("\n")
  return blocks(lines, tight: false).join("")
}

// Only the inline part (no <p>): for a title or a one-line comment.
pub fn inline_html(text: String) -> String {
  return inline(text.trim())
}

// ---- blocks

type Marker {
  ordered: Bool
  start: Int
  // the bullet or the delimiter: "-", "*", "+", "." or ")"
  kind: String
  // columns before the item's text starts
  width: Int
  content: String
}

fn blocks(lines: List<String>, tight: Bool) -> List<String> {
  var out: List<String> = []
  var i = 0
  while i < lines.length {
    let line = lines[i]
    let t = line.trim()
    if t.is_empty() {
      i += 1
      continue
    }
    // fenced code
    if t.starts_with("```") or t.starts_with("~~~") {
      let fence = t.slice(from: 0, to: 3)
      let lang = t.slice(from: 3, to: t.length).trim()
      var code: List<String> = []
      i += 1
      while i < lines.length and not lines[i].trim().starts_with(fence) {
        code.append(lines[i])
        i += 1
      }
      i += 1
      let cls = if lang.is_empty() { "" } else { " class=\"language-${escape(lang.split(" ")[0])}\"" }
      let body = if code.is_empty() { "" } else { "${escape(code.join("\n"))}\n" }
      out.append("<pre><code${cls}>${body}</code></pre>\n")
      continue
    }
    // indented code
    if line.starts_with("    ") {
      var code: List<String> = []
      while i < lines.length and (lines[i].starts_with("    ") or lines[i].trim().is_empty()) {
        code.append(if lines[i].length >= 4 { lines[i].slice(from: 4, to: lines[i].length) } else { "" })
        i += 1
      }
      while not code.is_empty() and (code.last() ?? "").trim().is_empty() {
        let _ = code.pop()
      }
      out.append("<pre><code>${escape(code.join("\n"))}\n</code></pre>\n")
      continue
    }
    // heading
    if t.starts_with("#") {
      var level = 0
      while level < t.length and t.slice(from: level, to: level + 1) == "#" {
        level += 1
      }
      let rest = t.slice(from: level, to: t.length)
      if level <= 6 and (rest.is_empty() or rest.starts_with(" ")) {
        var title = rest.trim()
        while title.ends_with("#") {
          title = title.slice(from: 0, to: title.length - 1)
        }
        out.append("<h${level}>${inline(title.trim())}</h${level}>\n")
        i += 1
        continue
      }
    }
    if is_rule(t) {
      out.append("<hr>\n")
      i += 1
      continue
    }
    // block quote: the > lines, and lines that continue their paragraph
    if t.starts_with(">") {
      var inner: List<String> = []
      while i < lines.length and not lines[i].trim().is_empty() {
        let q = lines[i].trim()
        if q.starts_with(">") {
          let body = q.slice(from: 1, to: q.length)
          inner.append(if body.starts_with(" ") { body.slice(from: 1, to: body.length) } else { body })
        } else if starts_block(q) {
          break
        } else {
          inner.append(q)
        }
        i += 1
      }
      out.append("<blockquote>\n${blocks(inner, tight: false).join("")}</blockquote>\n")
      continue
    }
    // table: a row, then a separator row
    if t.contains("|") and i + 1 < lines.length and is_table_rule(lines[i + 1].trim()) {
      let aligns = cells(lines[i + 1].trim()).map(c => alignment(c))
      var html = "<table>\n<thead>\n<tr>\n"
      let head = cells(t)
      for k in 0..<head.length {
        html = "${html}<th${align_attr(aligns, k: k)}>${inline(head[k])}</th>\n"
      }
      html = "${html}</tr>\n</thead>\n"
      i += 2
      var body = ""
      while i < lines.length and lines[i].trim().contains("|") {
        let row = cells(lines[i].trim())
        body = "${body}<tr>\n"
        for k in 0..<head.length {
          let cell = if k < row.length { row[k] } else { "" }
          body = "${body}<td${align_attr(aligns, k: k)}>${inline(cell)}</td>\n"
        }
        body = "${body}</tr>\n"
        i += 1
      }
      if not body.is_empty() {
        html = "${html}<tbody>\n${body}</tbody>\n"
      }
      out.append("${html}</table>\n")
      continue
    }
    // list
    if marker(line) is some(first) {
      var items: List<List<String>> = []
      var loose = false
      var blank_before = false
      while i < lines.length {
        let m = marker(lines[i]) ?? first
        let is_item = marker(lines[i]) is some(_) and m.ordered == first.ordered and m.kind == first.kind and indent_of(lines[i]) < first.width
        if not is_item {
          break
        }
        if blank_before {
          loose = true
        }
        var item = [m.content]
        i += 1
        blank_before = false
        while i < lines.length {
          let l = lines[i]
          if l.trim().is_empty() {
            blank_before = true
            item.append("")
            i += 1
            continue
          }
          if indent_of(l) >= m.width {
            if blank_before {
              loose = true
            }
            item.append(l.slice(from: m.width, to: l.length))
            blank_before = false
            i += 1
            continue
          }
          // a lazy continuation of the item's paragraph
          if not blank_before and not starts_block(l.trim()) and marker(l) is none {
            item.append(l.trim())
            i += 1
            continue
          }
          break
        }
        while not item.is_empty() and (item.last() ?? "").trim().is_empty() {
          let _ = item.pop()
        }
        items.append(item)
        if blank_before and (i >= lines.length or marker(lines[i]) is none) {
          break
        }
      }
      let tag = if first.ordered { "ol" } else { "ul" }
      let start = if first.ordered and first.start != 1 { " start=\"${first.start}\"" } else { "" }
      var html = "<${tag}${start}>\n"
      for item in items {
        let inner = blocks(item, tight: not loose).join("")
        // tight: the text right after <li>; a nested list keeps its lines
        let nested = inner.ends_with("</ul>\n") or inner.ends_with("</ol>\n")
        let body = if loose { "\n${inner}" } else if nested { inner } else { inner.trim_end() }
        html = "${html}<li>${body}</li>\n"
      }
      out.append("${html}</${tag}>\n")
      continue
    }
    // a paragraph, or a heading underlined with === / ---
    var para: List<String> = []
    while i < lines.length and not lines[i].trim().is_empty() {
      let l = lines[i]
      if not para.is_empty() {
        let u = l.trim()
        if u.length > 0 and (u.replace("=", "").is_empty() or u.replace("-", "").is_empty()) {
          let level = if u.starts_with("=") { 1 } else { 2 }
          out.append("<h${level}>${inline(para.map(p => p.trim()).join("\n"))}</h${level}>\n")
          para = []
          i += 1
          break
        }
        if starts_block(u) or marker(l) is some(_) {
          break
        }
      }
      para.append(l)
      i += 1
    }
    if not para.is_empty() {
      let text = inline(para.map(p => p.trim_start()).join("\n").trim_end())
      out.append(if tight { "${text}\n" } else { "<p>${text}</p>\n" })
    }
  }
  return out
}

fn starts_block(t: String) -> Bool {
  return t.starts_with("#") or t.starts_with(">") or t.starts_with("```") or t.starts_with("~~~") or is_rule(t)
}

fn is_rule(t: String) -> Bool {
  let s = t.replace(" ", "")
  if s.length < 3 {
    return false
  }
  for c in ["*", "-", "_"] {
    if s.replace(c, "").is_empty() {
      return true
    }
  }
  return false
}

fn indent_of(line: String) -> Int {
  var n = 0
  while n < line.length and line.slice(from: n, to: n + 1) == " " {
    n += 1
  }
  return n
}

fn marker(line: String) -> Marker? {
  let ind = indent_of(line)
  if ind > 3 {
    return none
  }
  let t = line.slice(from: ind, to: line.length)
  if t.length >= 2 and (t.starts_with("- ") or t.starts_with("* ") or t.starts_with("+ ")) and not is_rule(t) {
    let rest = t.slice(from: 2, to: t.length)
    let extra = indent_of(rest)
    let pad = if extra >= 1 and extra <= 4 { extra } else { 0 }
    return Marker(ordered: false, start: 0, kind: t.slice(from: 0, to: 1), width: ind + 2 + pad, content: rest.slice(from: pad, to: rest.length))
  }
  var d = 0
  while d < t.length and d < 9 and t.slice(from: d, to: d + 1).is_digit() {
    d += 1
  }
  if d > 0 and d + 1 < t.length and (t.slice(from: d, to: d + 1) == "." or t.slice(from: d, to: d + 1) == ")") and t.slice(from: d + 1, to: d + 2) == " " {
    let n = try t.slice(from: 0, to: d).to_int() catch err {
      return none
    }
    let rest = t.slice(from: d + 2, to: t.length)
    let extra = indent_of(rest)
    let pad = if extra >= 1 and extra <= 4 { extra } else { 0 }
    return Marker(ordered: true, start: n, kind: t.slice(from: d, to: d + 1), width: ind + d + 2 + pad, content: rest.slice(from: pad, to: rest.length))
  }
  return none
}

fn is_table_rule(t: String) -> Bool {
  if not t.contains("-") {
    return false
  }
  return cells(t).all(c => c.length > 0 and c.replace("-", "").replace(":", "").is_empty())
}

fn cells(row: String) -> List<String> {
  var r = row.trim()
  if r.starts_with("|") {
    r = r.slice(from: 1, to: r.length)
  }
  if r.ends_with("|") {
    r = r.slice(from: 0, to: r.length - 1)
  }
  return r.split("|").map(c => c.trim())
}

fn alignment(cell: String) -> String {
  let left = cell.starts_with(":")
  let right = cell.ends_with(":")
  if left and right {
    return "center"
  }
  if right {
    return "right"
  }
  if left {
    return "left"
  }
  return ""
}

fn align_attr(aligns: List<String>, k: Int) -> String {
  if k < aligns.length and not aligns[k].is_empty() {
    return " style=\"text-align: ${aligns[k]}\""
  }
  return ""
}

// ---- inline

fn escape(text: String) -> String {
  return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")
}

fn safe_url(url: String) -> String {
  let u = url.trim().lower()
  if u.starts_with("javascript:") or u.starts_with("vbscript:") or (u.starts_with("data:") and not u.starts_with("data:image/")) {
    return "#"
  }
  return escape(url.trim())
}

fn is_punct(c: String) -> Bool {
  return "!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~".contains(c) and c.length == 1
}

// the text of chars[from..to]
fn span(c: List<String>, from: Int, to: Int) -> String {
  return c.drop(from).take(to - from).join("")
}

// the position of `pat` in c at or after `from`, or -1
fn find(c: List<String>, pat: String, from: Int) -> Int {
  let p = pat.chars()
  var i = from
  while i + p.length <= c.length {
    var k = 0
    while k < p.length and c[i + k] == p[k] {
      k += 1
    }
    if k == p.length {
      return i
    }
    i += 1
  }
  return -1
}

// the `]` matching the `[` at `open`, or -1
fn close_bracket(c: List<String>, open: Int) -> Int {
  var depth = 0
  var i = open
  while i < c.length {
    if c[i] == "\\" {
      i += 2
      continue
    }
    if c[i] == "[" {
      depth += 1
    } else if c[i] == "]" {
      depth -= 1
      if depth == 0 {
        return i
      }
    }
    i += 1
  }
  return -1
}

type Target {
  url: String
  title: String
  // the position after the closing )
  next: Int
}

// "(url "title")" starting at `open`
fn target(c: List<String>, open: Int) -> Target? {
  if open >= c.length or c[open] != "(" {
    return none
  }
  // the ) that closes this (, counting nested ones: (javascript:alert(1))
  var close = -1
  var depth = 0
  var k = open
  while k < c.length {
    if c[k] == "(" {
      depth += 1
    } else if c[k] == ")" {
      depth -= 1
      if depth == 0 {
        close = k
        break
      }
    }
    k += 1
  }
  if close < 0 {
    return none
  }
  let inside = span(c, from: open + 1, to: close).trim()
  var url = inside
  var title = ""
  let q = inside.index_of(" \"")
  if q is some(at) {
    if inside.ends_with("\"") {
      url = inside.slice(from: 0, to: at)
      title = inside.slice(from: at + 2, to: inside.length - 1)
    }
  }
  if url.starts_with("<") and url.ends_with(">") {
    url = url.slice(from: 1, to: url.length - 1)
  }
  return Target(url: url, title: title, next: close + 1)
}

fn inline(text: String) -> String {
  let c = text.chars()
  var out: List<String> = []
  var i = 0
  while i < c.length {
    let ch = c[i]
    let next = if i + 1 < c.length { c[i + 1] } else { "" }
    // escapes and a backslash at the end of a line
    if ch == "\\" and next == "\n" {
      out.append("<br>\n")
      i += 2
      continue
    }
    if ch == "\\" and is_punct(next) {
      out.append(escape(next))
      i += 2
      continue
    }
    // code spans
    if ch == "`" {
      var n = 0
      while i + n < c.length and c[i + n] == "`" {
        n += 1
      }
      let fence = "`".repeat(n)
      let close = find(c, pat: fence, from: i + n)
      if close >= 0 {
        var code = span(c, from: i + n, to: close).replace("\n", " ")
        if code.starts_with(" ") and code.ends_with(" ") and code.trim().length > 0 {
          code = code.slice(from: 1, to: code.length - 1)
        }
        out.append("<code>${escape(code)}</code>")
        i = close + n
        continue
      }
      out.append(fence)
      i += n
      continue
    }
    // images and links
    if (ch == "!" and next == "[") or ch == "[" {
      let open = if ch == "!" { i + 1 } else { i }
      let close = close_bracket(c, open: open)
      if close > 0 {
        if target(c, open: close + 1) is some(t) {
          let label = span(c, from: open + 1, to: close)
          let title = if t.title.is_empty() { "" } else { " title=\"${escape(t.title)}\"" }
          if ch == "!" {
            out.append("<img src=\"${safe_url(t.url)}\" alt=\"${escape(label)}\"${title}>")
          } else {
            out.append("<a href=\"${safe_url(t.url)}\"${title}>${inline(label)}</a>")
          }
          i = t.next
          continue
        }
      }
    }
    // <https://...> and <someone@example.com>
    if ch == "<" {
      let close = find(c, pat: ">", from: i)
      if close > 0 {
        let inner = span(c, from: i + 1, to: close)
        if not inner.contains(" ") and (inner.contains("://") or (inner.contains("@") and inner.contains("."))) {
          let href = if inner.contains("://") { inner } else { "mailto:${inner}" }
          out.append("<a href=\"${safe_url(href)}\">${escape(inner)}</a>")
          i = close + 1
          continue
        }
      }
    }
    // bare links (GitHub)
    if ch == "h" and (i == 0 or c[i - 1] == " " or c[i - 1] == "\n" or c[i - 1] == "(") {
      let rest = span(c, from: i, to: min(i + 8, c.length))
      if rest.starts_with("https://") or rest.starts_with("http://") {
        var end = i
        while end < c.length and c[end] != " " and c[end] != "\n" and c[end] != "<" {
          end += 1
        }
        while end > i and ".,;:!?)\"'".contains(c[end - 1]) {
          end -= 1
        }
        let url = span(c, from: i, to: end)
        out.append("<a href=\"${safe_url(url)}\">${escape(url)}</a>")
        i = end
        continue
      }
    }
    // ~~strikethrough~~
    if ch == "~" and next == "~" {
      let close = find(c, pat: "~~", from: i + 2)
      if close > i + 2 {
        out.append("<del>${inline(span(c, from: i + 2, to: close))}</del>")
        i = close + 2
        continue
      }
    }
    // *emphasis*, **strong**, ***both***
    if ch == "*" or ch == "_" {
      var n = 0
      while i + n < c.length and c[i + n] == ch {
        n += 1
      }
      let after = if i + n < c.length { c[i + n] } else { " " }
      let before = if i > 0 { c[i - 1] } else { " " }
      let can_open = not after.is_space() and not (ch == "_" and before.is_letter())
      if can_open and n <= 3 {
        let run = ch.repeat(n)
        var close = find(c, pat: run, from: i + n)
        // a closing run follows text, and for _ isn't inside a word
        while close > 0 and (c[close - 1].is_space() or c[close - 1] == ch or (close + n < c.length and c[close + n] == ch) or (ch == "_" and close + n < c.length and c[close + n].is_letter())) {
          close = find(c, pat: run, from: close + 1)
        }
        if close > i + n {
          let inner = inline(span(c, from: i + n, to: close))
          out.append(match n {
            1 => "<em>${inner}</em>"
            2 => "<strong>${inner}</strong>"
            _ => "<em><strong>${inner}</strong></em>"
          })
          i = close + n
          continue
        }
      }
      out.append(ch.repeat(n))
      i += n
      continue
    }
    // two spaces before a line break: a hard break
    if ch == "\n" {
      var k = out.length
      var spaces = 0
      while k > 0 and out[k - 1] == " " {
        spaces += 1
        k -= 1
      }
      if spaces >= 2 {
        out = out.take(k)
        out.append("<br>\n")
      } else {
        out.append("\n")
      }
      i += 1
      continue
    }
    out.append(escape(ch))
    i += 1
  }
  return out.join("")
}
