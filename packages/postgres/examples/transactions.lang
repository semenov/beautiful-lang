import postgres
import time

type Count {
  n: Int
}

type Note {
  id: Int
  body: Text
  created: Text
  data: Bytes?
}

fn main() throws {
  with db = try postgres.connect("postgres://lang:secret@localhost:5432/lang") {
    try db.execute("drop table if exists notes", [])
    try db.execute("create table notes (id serial primary key, body text unique, created timestamptz default now(), data bytea)", [])
    // transactions: an error rolls everything back
    let failed = try db.transaction(() => try add_two(db)) catch err {
      print("transaction: ${err.message()}")
      0
    }
    let c = try db.query<Count>("select count(*)::int as n from notes", [])
    print("after rollback: ${c[0].n}")
    try db.execute("insert into notes (body, data) values ($1, $2)", ["bin", Bytes([0, 1, 255])])
    let notes = try db.query<Note>("select id, body, created::text as created, data from notes", [])
    print("${notes[0].body} ${(notes[0].data ?? Bytes()).to_list()}")
    let start = time.now()
    for i in 0..<5000 {
      try db.execute("insert into notes (body) values ($1)", ["note ${i}"])
    }
    print("5000 inserts: ${start.elapsed().millis() < 20000}")
    let s2 = time.now()
    let all = try db.query<Note>("select id, body, created::text as created from notes", [])
    print("${all.length} rows read in under a second: ${s2.elapsed().millis() < 1000}")
  }
}

fn add_two(db: postgres.Connection) throws -> Int {
  try db.execute("insert into notes (body) values ($1)", ["one"])
  try db.execute("insert into notes (body) values ($1)", ["one"])
  return 2
}
