// semver: semantic versions (https://semver.org) and version ranges, as
// npm and Cargo write them.
//
//   let v = try semver.parse("1.4.2-beta.1")
//   semver.compare(v, try semver.parse("1.4.2")) < 0          // true: a pre-release is lower
//   try semver.matches("1.4.2", range: "^1.2")                  // true
//   try semver.max_matching(["1.0.0", "1.5.3", "2.0.0"], range: "~1.5")  // "1.5.3"
//
// Ranges: exact "1.2.3", comparisons ">=1.2 <2", caret "^1.2.3" (same
// major; for 0.x the same minor), tilde "~1.2.3" (same minor), wildcards
// "1.x" / "1.2.*" / "*", hyphens "1.2 - 1.4", and alternatives with "||".
//
// Install: plumb add semver https://github.com/semenov/plumb --path packages/semver

pub type Version {
  major: Int
  minor: Int
  patch: Int
  // "beta.1" in 1.4.2-beta.1; empty for a release
  pre: String = ""
  // "build.5" in 1.4.2+build.5 (ignored when comparing)
  build: String = ""

  pub fn text(self) -> String {
    var s = "${self.major}.${self.minor}.${self.patch}"
    if not self.pre.is_empty() {
      s = "${s}-${self.pre}"
    }
    if not self.build.is_empty() {
      s = "${s}+${self.build}"
    }
    return s
  }

  pub fn next_major(self) -> Version {
    return Version(major: self.major + 1, minor: 0, patch: 0)
  }

  pub fn next_minor(self) -> Version {
    return Version(major: self.major, minor: self.minor + 1, patch: 0)
  }

  pub fn next_patch(self) -> Version {
    return Version(major: self.major, minor: self.minor, patch: self.patch + 1)
  }
}

// "1.2.3", "v1.2.3", "1.2.3-rc.1+build.7"
pub fn parse(text: String) throws -> Version {
  let bad = Failure(message: "semver: \"${text}\" is not a version like 1.2.3")
  var s = text.trim()
  if s.starts_with("v") or s.starts_with("=") {
    s = s.slice(from: 1, to: s.length)
  }
  var build = ""
  let plus = s.split("+")
  if plus.length > 1 {
    build = plus.drop(1).join("+")
    s = plus[0]
  }
  var pre = ""
  let dash = s.index_of("-")
  if dash is some(d) {
    pre = s.slice(from: d + 1, to: s.length)
    s = s.slice(from: 0, to: d)
  }
  let nums = s.split(".")
  if nums.length != 3 {
    throw bad
  }
  var parts: List<Int> = []
  for n in nums {
    if not n.is_digit() {
      throw bad
    }
    parts.append(try n.to_int())
  }
  return Version(major: parts[0], minor: parts[1], patch: parts[2], pre: pre, build: build)
}

// Negative if a < b, 0 if equal, positive if a > b (precedence rules of
// semver: a pre-release is lower than its release; build data is ignored).
pub fn compare(a: Version, b: Version) -> Int {
  for d in [a.major - b.major, a.minor - b.minor, a.patch - b.patch] {
    if d != 0 {
      return d
    }
  }
  if a.pre == b.pre {
    return 0
  }
  if a.pre.is_empty() {
    return 1
  }
  if b.pre.is_empty() {
    return -1
  }
  let x = a.pre.split(".")
  let y = b.pre.split(".")
  for i in 0..<min(x.length, y.length) {
    if x[i] == y[i] {
      continue
    }
    let xn = x[i].is_digit()
    let yn = y[i].is_digit()
    if xn and yn {
      return (try x[i].to_int() catch err { 0 }) - (try y[i].to_int() catch err { 0 })
    }
    if xn {
      return -1
    }
    if yn {
      return 1
    }
    return if x[i] < y[i] { -1 } else { 1 }
  }
  return x.length - y.length
}

// Sorted from lowest to highest.
pub fn sort(versions: List<Version>) -> List<Version> {
  var out = versions
  // insertion sort: version lists are short
  for i in 1..<out.length {
    var j = i
    while j > 0 and compare(out[j - 1], b: out[j]) > 0 {
      let t = out[j - 1]
      out[j - 1] = out[j]
      out[j] = t
      j -= 1
    }
  }
  return out
}

// Whether a version is in a range.
pub fn matches(version: String, range: String) throws -> Bool {
  let v = try parse(version)
  for alternative in range.split("||") {
    if try all_hold(v, conditions: try conditions(alternative.trim())) {
      return true
    }
  }
  return false
}

// The highest version in the range; none if no version matches.
pub fn max_matching(versions: List<String>, range: String) throws -> String? {
  var best: Version? = none
  for text in versions {
    if not (try matches(text, range: range)) {
      continue
    }
    let v = try parse(text)
    if best is some(b) {
      if compare(v, b: b) > 0 {
        best = v
      }
    } else {
      best = v
    }
  }
  if best is some(b) {
    return b.text()
  }
  return none
}

// ---- ranges

type Condition {
  // "<", "<=", ">", ">=", "="
  op: String
  version: Version
}

fn all_hold(v: Version, conditions: List<Condition>) throws -> Bool {
  // a pre-release matches only ranges that mention a pre-release of the
  // same major.minor.patch (npm's rule)
  if not v.pre.is_empty() and not conditions.any(c => not c.version.pre.is_empty() and c.version.major == v.major and c.version.minor == v.minor and c.version.patch == v.patch) {
    return false
  }
  for c in conditions {
    let d = compare(v, b: c.version)
    let ok = match c.op {
      "<" => d < 0
      "<=" => d <= 0
      ">" => d > 0
      ">=" => d >= 0
      _ => d == 0
    }
    if not ok {
      return false
    }
  }
  return true
}

// "1.2" -> [1, 2] and how many parts were given (x and * are missing parts)
type Partial {
  nums: List<Int>
  given: Int
  pre: String
}

fn partial(text: String) throws -> Partial {
  var s = text.trim()
  if s.starts_with("v") {
    s = s.slice(from: 1, to: s.length)
  }
  var pre = ""
  let dash = s.index_of("-")
  if dash is some(d) {
    pre = s.slice(from: d + 1, to: s.length)
    s = s.slice(from: 0, to: d)
  }
  var nums: List<Int> = []
  var given = 0
  for p in s.split(".") {
    if p == "x" or p == "X" or p == "*" or p.is_empty() {
      break
    }
    if not p.is_digit() {
      throw Failure(message: "semver: \"${text}\" is not a version in a range")
    }
    nums.append(try p.to_int())
    given += 1
  }
  while nums.length < 3 {
    nums.append(0)
  }
  return Partial(nums: nums, given: given, pre: pre)
}

fn at(p: Partial) -> Version {
  return Version(major: p.nums[0], minor: p.nums[1], patch: p.nums[2], pre: p.pre)
}

fn conditions(range: String) throws -> List<Condition> {
  if range.is_empty() or range == "*" or range == "x" {
    return []
  }
  // "1.2 - 1.4"
  let hyphen = range.split(" - ")
  if hyphen.length == 2 {
    let low = try partial(hyphen[0])
    let high = try partial(hyphen[1])
    var out = [Condition(op: ">=", version: at(low))]
    if high.given == 3 {
      out.append(Condition(op: "<=", version: at(high)))
    } else if high.given > 0 {
      out.append(Condition(op: "<", version: bump(high)))
    }
    return out
  }
  var out: List<Condition> = []
  for word in range.split(" ").filter(w => not w.is_empty()) {
    out.append_all(try one(word))
  }
  return out
}

// the first version past a partial one: 1.2 -> 1.3.0, 1 -> 2.0.0
fn bump(p: Partial) -> Version {
  if p.given <= 1 {
    return Version(major: p.nums[0] + 1, minor: 0, patch: 0)
  }
  return Version(major: p.nums[0], minor: p.nums[1] + 1, patch: 0)
}

fn one(word: String) throws -> List<Condition> {
  for op in [">=", "<=", ">", "<", "="] {
    if word.starts_with(op) {
      let p = try partial(word.slice(from: op.length, to: word.length))
      if op == "<=" and p.given < 3 {
        return [Condition(op: "<", version: bump(p))]
      }
      if op == ">" and p.given < 3 {
        return [Condition(op: ">=", version: bump(p))]
      }
      return [Condition(op: op, version: at(p))]
    }
  }
  if word.starts_with("^") {
    let p = try partial(word.slice(from: 1, to: word.length))
    let low = at(p)
    let high = if p.nums[0] > 0 or p.given <= 1 {
      Version(major: p.nums[0] + 1, minor: 0, patch: 0)
    } else if p.nums[1] > 0 or p.given <= 2 {
      Version(major: 0, minor: p.nums[1] + 1, patch: 0)
    } else {
      Version(major: 0, minor: 0, patch: p.nums[2] + 1)
    }
    return [Condition(op: ">=", version: low), Condition(op: "<", version: high)]
  }
  if word.starts_with("~") {
    let p = try partial(word.slice(from: 1, to: word.length))
    let high = if p.given <= 1 { Version(major: p.nums[0] + 1, minor: 0, patch: 0) } else { Version(major: p.nums[0], minor: p.nums[1] + 1, patch: 0) }
    return [Condition(op: ">=", version: at(p)), Condition(op: "<", version: high)]
  }
  let p = try partial(word)
  if p.given == 3 {
    return [Condition(op: "=", version: at(p))]
  }
  if p.given == 0 {
    return []
  }
  return [Condition(op: ">=", version: at(p)), Condition(op: "<", version: bump(p))]
}
