import semver

fn main() throws {
  let order = ["1.0.0-alpha", "1.0.0-alpha.1", "1.0.0-alpha.beta", "1.0.0-beta", "1.0.0-beta.2", "1.0.0-beta.11", "1.0.0-rc.1", "1.0.0"]
  var parsed: List<semver.Version> = []
  for t in order.reversed() {
    parsed.append(try semver.parse(t))
  }
  print("spec order: ${semver.sort(parsed).map(v => v.text()) == order}")
  let cases = [["1.4.2", "^1.2"], ["2.0.0", "^1.2"], ["0.2.5", "^0.2.3"], ["0.3.0", "^0.2.3"], ["1.2.9", "~1.2.3"], ["1.3.0", "~1.2.3"], ["1.9.9", "1.x"], ["2.0.0", "1.x"], ["1.5.0", ">=1.2 <2"], ["1.3.4", "1.2 - 1.4"], ["1.5.0", "1.2 - 1.4"], ["3.1.0", "^1 || ^3"], ["1.2.3-beta", "^1.2"], ["1.2.3-beta.2", ">=1.2.3-beta.1"], ["5.0.0", "*"]]
  for c in cases {
    print("${c[0]} in ${c[1]}: ${try semver.matches(c[0], range: c[1])}")
  }
  print("max: ${try semver.max_matching(["1.0.0", "1.5.3", "1.5.10", "2.0.0"], range: "~1.5") ?? "none"}")
  let _ = try semver.parse("1.2") catch err {
    print(err.message())
    semver.Version(major: 0, minor: 0, patch: 0)
  }
}
