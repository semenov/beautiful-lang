// time: clocks, durations and waiting.

pub type Duration {
  nanos: Int

  pub fn seconds(self) -> Float {
    return self.nanos.to_float() / 1000000000.0
  }

  pub fn millis(self) -> Int {
    return self.nanos.div(1000000)
  }

  pub fn plus(self, other: Duration) -> Duration {
    return Duration(nanos: self.nanos + other.nanos)
  }

  pub fn minus(self, other: Duration) -> Duration {
    return Duration(nanos: self.nanos - other.nanos)
  }

  pub fn times(self, n: Int) -> Duration {
    return Duration(nanos: self.nanos * n)
  }

  pub fn is_longer_than(self, other: Duration) -> Bool {
    return self.nanos > other.nanos
  }

  pub fn is_shorter_than(self, other: Duration) -> Bool {
    return self.nanos < other.nanos
  }

  // A part of it: `total.divided_by(count)` is the average.
  pub fn divided_by(self, n: Int) -> Duration {
    return Duration(nanos: self.nanos.div(n))
  }

  // Its text in "${d}": as `text()`.
  pub fn to_string(self) -> String {
    return self.text()
  }

  // For people: "1h30m", "2m5s", "1.5s", "250ms", "80µs", "12ns".
  pub fn text(self) -> String {
    let n = self.nanos
    if n < 0 {
      return "-${Duration(nanos: 0 - n).text()}"
    }
    if n < 1000 {
      return "${n}ns"
    }
    if n < 1000000 {
      return "${trim_zeros((n.to_float() / 1000.0).format(1))}µs"
    }
    if n < 1000000000 {
      return "${trim_zeros((n.to_float() / 1000000.0).format(1))}ms"
    }
    let total = n.div(1000000000)
    let h = total.div(3600)
    let m = (total % 3600).div(60)
    let s = total % 60
    var out = ""
    if h > 0 {
      out = "${h}h"
    }
    if m > 0 {
      out = "${out}${m}m"
    }
    if h == 0 and m == 0 {
      return "${trim_zeros((n.to_float() / 1000000000.0).format(3))}s"
    }
    if s > 0 {
      out = "${out}${s}s"
    }
    return out
  }
}

fn trim_zeros(t: String) -> String {
  if not t.contains(".") {
    return t
  }
  var s = t
  while s.ends_with("0") {
    s = s.slice(from: 0, to: s.length - 1)
  }
  if s.ends_with(".") {
    s = s.slice(from: 0, to: s.length - 1)
  }
  return s
}

pub fn minutes(n: Int) -> Duration {
  return Duration(nanos: n * 60000000000)
}

pub fn hours(n: Int) -> Duration {
  return Duration(nanos: n * 3600000000000)
}

pub fn days(n: Int) -> Duration {
  return Duration(nanos: n * 86400000000000)
}

// "1h30m", "90s", "1.5s", "250ms", "10us" (or µs), "10ns", "2d", "-5m".
pub fn parse_duration(text: String) throws -> Duration {
  let bad = Failure(message: "time: \"${text}\" is not a duration like 1h30m, 90s or 250ms")
  var s = text.trim()
  var sign = 1
  if s.starts_with("-") {
    sign = -1
    s = s.slice(from: 1, to: s.length)
  }
  if s.is_empty() {
    throw bad
  }
  var total = 0.0
  var i = 0
  let chars = s.chars()
  while i < chars.length {
    var number = ""
    while i < chars.length and "0123456789.".contains(chars[i]) {
      number = "${number}${chars[i]}"
      i += 1
    }
    var unit = ""
    while i < chars.length and not "0123456789.".contains(chars[i]) {
      unit = "${unit}${chars[i]}"
      i += 1
    }
    if number.is_empty() {
      throw bad
    }
    let value = try number.to_float() catch err {
      throw bad
    }
    let scale = match unit {
      "ns" => 1.0
      "us" => 1000.0
      "µs" => 1000.0
      "ms" => 1000000.0
      "s" => 1000000000.0
      "m" => 60000000000.0
      "h" => 3600000000000.0
      "d" => 86400000000000.0
      _ => -1.0
    }
    if scale < 0.0 {
      throw bad
    }
    total = total + value * scale
  }
  return Duration(nanos: total.round() * sign)
}

pub fn seconds(n: Int) -> Duration {
  return Duration(nanos: n * 1000000000)
}

pub fn micros(n: Int) -> Duration {
  return Duration(nanos: n * 1000)
}

pub fn nanos(n: Int) -> Duration {
  return Duration(nanos: n)
}

pub fn millis(n: Int) -> Duration {
  return Duration(nanos: n * 1000000)
}

// A point in time, for measuring how long something takes.
pub type Instant {
  nanos: Int

  pub fn elapsed(self) -> Duration {
    return Duration(nanos: __monotonic_nanos() - self.nanos)
  }

  pub fn plus(self, d: Duration) -> Instant {
    return Instant(nanos: self.nanos + d.nanos)
  }

  // How long from `earlier` to this moment.
  pub fn since(self, earlier: Instant) -> Duration {
    return Duration(nanos: self.nanos - earlier.nanos)
  }
}

pub fn now() -> Instant {
  return Instant(nanos: __monotonic_nanos())
}

fn __monotonic_nanos() -> Int

// Wait without blocking other tasks. Fails with `Cancelled` if the task is cancelled.
pub fn sleep(duration: Duration) throws {
  try __sleep_nanos(duration.nanos)
}

fn __sleep_nanos(nanos: Int) throws

// Waits until a moment (now or in the past: doesn't wait). For steady
// ticks, sleep until start + interval × n rather than a fixed interval,
// so the time the work takes doesn't add up:
//   for n in 1..=10 { try time.sleep_until(start.plus(interval.times(n))) ... }
pub fn sleep_until(moment: Instant) throws {
  try __sleep_nanos(moment.nanos - __monotonic_nanos())
}

// Runs `work`, giving up after `duration`: the work is cancelled (whatever
// it waits for stops with an error, its own tasks too) and `timeout`
// throws `TimedOut`.
//
//   let page = try time.timeout(time.seconds(5), () => try http.get(url))
pub fn timeout<R>(duration: Duration, work: fn() throws -> R) throws -> R {
  let task = spawn work()
  let deadline = __cancel_after(task, duration.nanos)
  let result = try task.wait() catch err {
    if __deadline_stop(deadline) {
      throw TimedOut(after: duration)
    }
    throw err
  }
  let _ = __deadline_stop(deadline)
  return result
}

// The error of `timeout`.
pub type TimedOut implements Error {
  after: Duration

  fn message(self) -> String {
    return "timed out after ${self.after.seconds()}s"
  }
}

fn __cancel_after<R>(task: Task<R>, nanos: Int) -> Int
fn __deadline_stop(handle: Int) -> Bool

// A moment in UTC, from the wall clock.
pub type DateTime {
  year: Int
  month: Int
  day: Int
  hour: Int
  minute: Int
  second: Int

  // Its text in "${x}": as `iso()`.
  pub fn to_string(self) -> String {
    return self.iso()
  }

  // "2026-09-29T12:00:00Z"
  pub fn iso(self) -> String {
    let d = "${self.year}-${pad(self.month)}-${pad(self.day)}"
    return "${d}T${pad(self.hour)}:${pad(self.minute)}:${pad(self.second)}Z"
  }

  // The same moment on the wall clock of a time zone:
  //   let berlin = try moment.in_zone("Europe/Berlin")   // 14:05 UTC -> 16:05 +02:00
  pub fn in_zone(self, zone: String) throws -> Zoned {
    var abbr: List<String> = []
    let f = try __zone_fields(zone, unix: self.to_unix(), abbreviation: abbr)
    return Zoned(year: f[0], month: f[1], day: f[2], hour: f[3], minute: f[4], second: f[5], offset: f[6], zone: zone, abbreviation: abbr.first() ?? zone)
  }

  // The calendar day.
  pub fn date(self) -> Date {
    return Date(year: self.year, month: self.month, day: self.day)
  }

  pub fn weekday(self) -> Weekday {
    return self.date().weekday()
  }

  // As a pattern says (strftime): "%Y-%m-%d %H:%M" gives "2026-09-29 12:30".
  // %Y year, %m month, %d day, %H hour, %M minute, %S second, %y two-digit
  // year, %e day without zero, %I hour 1-12, %p AM/PM, %B September, %b Sep,
  // %A Tuesday, %a Tue, %j day of the year, %s Unix seconds, %z +0000,
  // %Z UTC, %% a percent sign.
  pub fn format(self, pattern: String) -> String {
    return format_parts(self, pattern: pattern, offset: 0, zone: "UTC")
  }

  pub fn is_before(self, other: DateTime) -> Bool {
    return self.to_unix() < other.to_unix()
  }

  pub fn is_after(self, other: DateTime) -> Bool {
    return self.to_unix() > other.to_unix()
  }

  // The same day and time `n` months later; the day is clamped to the
  // month's length (Jan 31 + 1 month = Feb 28).
  pub fn plus_months(self, n: Int) -> DateTime {
    let d = self.date().plus_months(n)
    var r = self
    r.year = d.year
    r.month = d.month
    r.day = d.day
    return r
  }

  // Seconds since 1970-01-01 UTC.
  pub fn to_unix(self) -> Int {
    let y = if self.month <= 2 { self.year - 1 } else { self.year }
    let era = y.div(400)
    let yoe = y - era * 400
    let mp = if self.month > 2 { self.month - 3 } else { self.month + 9 }
    let doy = (153 * mp + 2).div(5) + self.day - 1
    let doe = yoe * 365 + yoe.div(4) - yoe.div(100) + doy
    let days = era * 146097 + doe - 719468
    return days * 86400 + self.hour * 3600 + self.minute * 60 + self.second
  }

  // A moment `seconds` later (or earlier, if negative).
  pub fn plus_seconds(self, seconds: Int) -> DateTime {
    return from_unix(self.to_unix() + seconds)
  }

  pub fn plus_days(self, days: Int) -> DateTime {
    return from_unix(self.to_unix() + days * 86400)
  }
}

// Reads "2026-09-29", "2026-09-29T12:30:00Z" or "2026-09-29 12:30:00"
// (UTC; an offset like +02:00 is converted to UTC).
pub fn parse_iso(text: String) throws -> DateTime {
  let t = text.trim()
  let bad = Failure(message: "time: \"${text}\" is not a date like 2026-09-29 or 2026-09-29T12:30:00Z")
  if t.length < 10 {
    throw bad
  }
  let d = t.slice(from: 0, to: 10).split("-")
  if d.length != 3 {
    throw bad
  }
  let year = try d[0].to_int() catch err {
    throw bad
  }
  let month = try d[1].to_int() catch err {
    throw bad
  }
  let day = try d[2].to_int() catch err {
    throw bad
  }
  if month < 1 or month > 12 or day < 1 or day > 31 {
    throw bad
  }
  var result = DateTime(year: year, month: month, day: day, hour: 0, minute: 0, second: 0)
  if t.length == 10 {
    return result
  }
  if t.length < 19 {
    throw bad
  }
  let clock = t.slice(from: 11, to: 19).split(":")
  if clock.length != 3 {
    throw bad
  }
  result.hour = try clock[0].to_int() catch err {
    throw bad
  }
  result.minute = try clock[1].to_int() catch err {
    throw bad
  }
  let secs = clock[2]
  result.second = try secs.to_int() catch err {
    throw bad
  }
  var zone = t.slice(from: 19, to: t.length)
  if zone.starts_with(".") {
    // fractions of a second are dropped
    var i = 1
    while i < zone.length and "0123456789".contains(zone.slice(from: i, to: i + 1)) {
      i += 1
    }
    zone = zone.slice(from: i, to: zone.length)
  }
  if zone == "" or zone == "Z" {
    return result
  }
  if zone.length == 6 and (zone.starts_with("+") or zone.starts_with("-")) {
    let oh = try zone.slice(from: 1, to: 3).to_int() catch err {
      throw bad
    }
    let om = try zone.slice(from: 4, to: 6).to_int() catch err {
      throw bad
    }
    let offset = (oh * 3600 + om * 60) * (if zone.starts_with("+") { -1 } else { 1 })
    return result.plus_seconds(offset)
  }
  throw bad
}

fn pad(n: Int) -> String {
  return n.to_string().pad_start(width: 2, fill: "0")
}

// The current date and time in UTC.
pub fn utc_now() -> DateTime {
  return from_unix(unix_now())
}

// Seconds since 1970-01-01 UTC.
pub fn unix_now() -> Int

// Milliseconds since 1970-01-01 UTC (the wall clock; for measuring how long
// something takes, `time.now()` is steady).
pub fn unix_millis() -> Int

// The date and time of a Unix timestamp.
pub fn from_unix(seconds: Int) -> DateTime {
  // days since 1970 -> civil date (Howard Hinnant's algorithm)
  let days = seconds.div(86400)
  let rest = seconds - days * 86400
  let z = days + 719468
  let era = z.div(146097)
  let doe = z - era * 146097
  let yoe = (doe - doe.div(1460) + doe.div(36524) - doe.div(146096)).div(365)
  let doy = doe - (365 * yoe + yoe.div(4) - yoe.div(100))
  let mp = (5 * doy + 2).div(153)
  let day = doy - (153 * mp + 2).div(5) + 1
  let month = if mp < 10 { mp + 3 } else { mp - 9 }
  let year = yoe + era * 400 + (if month <= 2 { 1 } else { 0 })
  return DateTime(year: year, month: month, day: day, hour: rest.div(3600), minute: (rest % 3600).div(60), second: rest % 60)
}

pub enum Weekday {
  Monday
  Tuesday
  Wednesday
  Thursday
  Friday
  Saturday
  Sunday
}

fn weekday_name(w: Weekday) -> String {
  return match w {
    Monday => "Monday"
    Tuesday => "Tuesday"
    Wednesday => "Wednesday"
    Thursday => "Thursday"
    Friday => "Friday"
    Saturday => "Saturday"
    Sunday => "Sunday"
  }
}

fn month_name(m: Int) -> String {
  let names = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
  return names[m - 1]
}

fn days_in_month(year: Int, month: Int) -> Int {
  if month == 2 {
    let leap = (year % 4 == 0 and year % 100 != 0) or year % 400 == 0
    return if leap { 29 } else { 28 }
  }
  return if month == 4 or month == 6 or month == 9 or month == 11 { 30 } else { 31 }
}

// A calendar day, without a time or a zone: birthdays, due dates, reports.
pub type Date {
  year: Int
  month: Int
  day: Int

  // Its text in "${x}": as `iso()`.
  pub fn to_string(self) -> String {
    return self.iso()
  }

  // "2026-09-29"
  pub fn iso(self) -> String {
    return "${self.year.to_string().pad_start(width: 4, fill: "0")}-${pad(self.month)}-${pad(self.day)}"
  }

  // Days since 1970-01-01 (negative before).
  pub fn to_days(self) -> Int {
    return DateTime(year: self.year, month: self.month, day: self.day, hour: 0, minute: 0, second: 0).to_unix().div(86400)
  }

  pub fn plus_days(self, n: Int) -> Date {
    return from_unix((self.to_days() + n) * 86400).date()
  }

  // Clamped to the month's length: Jan 31 + 1 month = Feb 28.
  pub fn plus_months(self, n: Int) -> Date {
    let m0 = self.year * 12 + (self.month - 1) + n
    let year = m0.div(12)
    let month = m0 - year * 12 + 1
    return Date(year: year, month: month, day: min(self.day, days_in_month(year, month: month)))
  }

  // Days from this date to `other` (negative if `other` is earlier).
  pub fn days_until(self, other: Date) -> Int {
    return other.to_days() - self.to_days()
  }

  pub fn weekday(self) -> Weekday {
    // 1970-01-01 was a Thursday
    let names = [Weekday.Thursday, Weekday.Friday, Weekday.Saturday, Weekday.Sunday, Weekday.Monday, Weekday.Tuesday, Weekday.Wednesday]
    let i = self.to_days() % 7
    return names[if i < 0 { i + 7 } else { i }]
  }

  pub fn is_before(self, other: Date) -> Bool {
    return self.to_days() < other.to_days()
  }

  pub fn is_after(self, other: Date) -> Bool {
    return self.to_days() > other.to_days()
  }

  // This day at a time of day, in UTC.
  pub fn at(self, hour: Int, minute: Int, second: Int) -> DateTime {
    return DateTime(year: self.year, month: self.month, day: self.day, hour: hour, minute: minute, second: second)
  }

  pub fn format(self, pattern: String) -> String {
    return self.at(0, minute: 0, second: 0).format(pattern)
  }
}

// Today in UTC.
pub fn today() -> Date {
  return utc_now().date()
}

// "2026-09-29"
pub fn parse_date(text: String) throws -> Date {
  return (try parse_iso(text.trim().slice(from: 0, to: min(text.trim().length, 10)))).date()
}

fn format_parts(dt: DateTime, pattern: String, offset: Int, zone: String) -> String {
  var out: List<String> = []
  let chars = pattern.chars()
  var i = 0
  while i < chars.length {
    let c = chars[i]
    if c != "%" or i + 1 >= chars.length {
      out.append(c)
      i += 1
      continue
    }
    let f = chars[i + 1]
    i += 2
    let hour12 = if dt.hour % 12 == 0 { 12 } else { dt.hour % 12 }
    let sign = if offset < 0 { "-" } else { "+" }
    let off = if offset < 0 { 0 - offset } else { offset }
    out.append(match f {
      "Y" => dt.year.to_string()
      "m" => pad(dt.month)
      "d" => pad(dt.day)
      "e" => dt.day.to_string()
      "H" => pad(dt.hour)
      "M" => pad(dt.minute)
      "S" => pad(dt.second)
      "y" => pad(dt.year % 100)
      "I" => pad(hour12)
      "p" => if dt.hour < 12 { "AM" } else { "PM" }
      "B" => month_name(dt.month)
      "b" => month_name(dt.month).slice(from: 0, to: 3)
      "A" => weekday_name(dt.weekday())
      "a" => weekday_name(dt.weekday()).slice(from: 0, to: 3)
      "j" => (dt.date().to_days() - Date(year: dt.year, month: 1, day: 1).to_days() + 1).to_string().pad_start(width: 3, fill: "0")
      "s" => (dt.to_unix() - offset).to_string()
      "z" => "${sign}${pad(off.div(3600))}${pad((off % 3600).div(60))}"
      "Z" => zone
      "%" => "%"
      _ => "%${f}"
    })
  }
  return out.join("")
}

// Reads a date and time written as `pattern` says (see `DateTime.format`):
//   try time.parse("29/09/2026 14:05", pattern: "%d/%m/%Y %H:%M")
// Fields the pattern doesn't have are 0 (or 1 for month and day); with %z
// the result is converted to UTC.
pub fn parse(text: String, pattern: String) throws -> DateTime {
  let bad = Failure(message: "time: \"${text}\" doesn't match the pattern \"${pattern}\"")
  let s = text.chars()
  let p = pattern.chars()
  var r = DateTime(year: 1970, month: 1, day: 1, hour: 0, minute: 0, second: 0)
  var pm = -1
  var offset = 0
  var i = 0
  var j = 0
  while j < p.length {
    if p[j] != "%" or j + 1 >= p.length {
      if i >= s.length or s[i] != p[j] {
        throw bad
      }
      i += 1
      j += 1
      continue
    }
    let f = p[j + 1]
    j += 2
    if f == "%" {
      if i >= s.length or s[i] != "%" {
        throw bad
      }
      i += 1
      continue
    }
    if f == "p" {
      let word = s.drop(i).take(2).join("").upper()
      if word != "AM" and word != "PM" {
        throw bad
      }
      pm = if word == "PM" { 1 } else { 0 }
      i += 2
      continue
    }
    if f == "B" or f == "b" {
      var found = 0
      for m in 1..=12 {
        let name = if f == "B" { month_name(m) } else { month_name(m).slice(from: 0, to: 3) }
        if s.drop(i).take(name.length).join("").lower() == name.lower() {
          found = m
          i += name.length
          break
        }
      }
      if found == 0 {
        throw bad
      }
      r.month = found
      continue
    }
    if f == "Z" {
      while i < s.length and s[i] != " " {
        i += 1
      }
      continue
    }
    if f == "z" {
      if i < s.length and s[i] == "Z" {
        i += 1
        continue
      }
      if i + 5 > s.length or (s[i] != "+" and s[i] != "-") {
        throw bad
      }
      let digits = s.drop(i + 1).take(5).join("").replace(":", "")
      let hh = try digits.slice(from: 0, to: 2).to_int() catch err {
        throw bad
      }
      let mm = try digits.slice(from: 2, to: 4).to_int() catch err {
        throw bad
      }
      offset = (hh * 3600 + mm * 60) * (if s[i] == "-" { -1 } else { 1 })
      i += if s.drop(i + 1).take(3).join("").contains(":") { 6 } else { 5 }
      continue
    }
    let width = if f == "Y" { 4 } else if f == "j" { 3 } else { 2 }
    var digits = ""
    while i < s.length and digits.length < width and "0123456789".contains(s[i]) {
      digits = "${digits}${s[i]}"
      i += 1
    }
    let n = try digits.to_int() catch err {
      throw bad
    }
    if f == "Y" {
      r.year = n
    } else if f == "y" {
      r.year = 2000 + n
    } else if f == "m" {
      r.month = n
    } else if f == "d" or f == "e" {
      r.day = n
    } else if f == "H" or f == "I" {
      r.hour = n
    } else if f == "M" {
      r.minute = n
    } else if f == "S" {
      r.second = n
    } else {
      throw bad
    }
  }
  if i != s.length {
    throw bad
  }
  if pm == 1 and r.hour < 12 {
    r.hour += 12
  }
  if pm == 0 and r.hour == 12 {
    r.hour = 0
  }
  if r.month < 1 or r.month > 12 or r.day < 1 or r.day > days_in_month(r.year, month: r.month) or r.hour > 23 or r.minute > 59 or r.second > 60 {
    throw bad
  }
  return r.plus_seconds(0 - offset)
}

// A moment as the wall clock of a time zone shows it.
pub type Zoned {
  year: Int
  month: Int
  day: Int
  hour: Int
  minute: Int
  second: Int
  // seconds east of UTC: 7200 for Berlin in summer, -18000 for New York in winter
  offset: Int
  // "Europe/Berlin"
  zone: String
  // "CEST"
  abbreviation: String

  // Its text in "${x}": as `iso()`.
  pub fn to_string(self) -> String {
    return self.iso()
  }

  // "2026-09-29T16:05:09+02:00"
  pub fn iso(self) -> String {
    let sign = if self.offset < 0 { "-" } else { "+" }
    let off = if self.offset < 0 { 0 - self.offset } else { self.offset }
    return "${self.wall().iso().slice(from: 0, to: 19)}${sign}${pad(off.div(3600))}:${pad((off % 3600).div(60))}"
  }

  // As `DateTime.format`; %z gives the offset (+0200), %Z the abbreviation.
  pub fn format(self, pattern: String) -> String {
    return format_parts(self.wall(), pattern: pattern, offset: self.offset, zone: self.abbreviation)
  }

  // The same moment in UTC.
  pub fn utc(self) -> DateTime {
    return self.wall().plus_seconds(0 - self.offset)
  }

  pub fn date(self) -> Date {
    return Date(year: self.year, month: self.month, day: self.day)
  }

  fn wall(self) -> DateTime {
    return DateTime(year: self.year, month: self.month, day: self.day, hour: self.hour, minute: self.minute, second: self.second)
  }
}

// The moment when the wall clock in `zone` shows this date and time:
//   let meeting = try time.in_zone("Europe/Berlin", date: d, hour: 9, minute: 30)
// A time skipped by a clock change moves forward; a repeated one takes
// the first.
pub fn in_zone(zone: String, date: Date, hour: Int, minute: Int) throws -> DateTime {
  return from_unix(try __zone_unix(zone, fields: [date.year, date.month, date.day, hour, minute, 0]))
}

// Now, on the wall clock of `zone`.
pub fn now_in(zone: String) throws -> Zoned {
  return try utc_now().in_zone(zone)
}

// This machine's zone ("Europe/Berlin"): TZ, else the system setting,
// else "UTC".
pub fn local_zone() -> String

fn __zone_fields(zone: String, unix: Int, abbreviation: List<String>) throws -> List<Int>
fn __zone_unix(zone: String, fields: List<Int>) throws -> Int
