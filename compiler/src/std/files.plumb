// files: read and write files and directories. Paths are text; errors say
// which path failed and why.

import io
import path

// The kinds of failure a program often handles on its own:
// `try files.read(p) catch err { if err is files.NotFound { ... } }`.
// Other failures are a `Failure` with the system's reason.

// Nothing exists at the path.
pub type NotFound implements Error {
  path: String
  // what failed and why: `can't read "a.txt": No such file or directory`
  text: String

  fn message(self) -> String {
    return self.text
  }
}

// The permissions don't allow it.
pub type PermissionDenied implements Error {
  path: String
  text: String

  fn message(self) -> String {
    return self.text
  }
}

// A file was expected, and the path is a directory.
pub type IsADirectory implements Error {
  path: String
  text: String

  fn message(self) -> String {
    return self.text
  }
}

// Something already exists at the path.
pub type AlreadyExists implements Error {
  path: String
  text: String

  fn message(self) -> String {
    return self.text
  }
}

// The whole file as text.
pub fn read(path: String) throws -> String
// The whole file as bytes.
pub fn read_bytes(path: String) throws -> Bytes
// Creates or replaces the file.
pub fn write(path: String, text: String) throws
pub fn write_bytes(path: String, data: Bytes) throws
// Adds to the end of the file, creating it if needed.
pub fn append(path: String, text: String) throws
pub fn exists(path: String) -> Bool
pub fn is_dir(path: String) -> Bool
// Names of the entries in a directory, sorted.
pub fn list(dir: String) throws -> List<String>
// Every file under a directory, at any depth, as paths starting with
// `dir` ("src/a/b.plumb"; for "." just "a/b.plumb"), sorted. Symlinked
// directories aren't followed.
pub fn walk(dir: String) throws -> List<String>
// The files matching a pattern, sorted: "*.txt", "src/**/*.plumb",
// "logs/2026-*.{log,gz}" (see `path.matches`).
pub fn glob(pattern: String) throws -> List<String> {
  let parts = pattern.split("/")
  var fixed: List<String> = []
  for part in parts {
    if part.contains("*") or part.contains("?") or part.contains("[") or part.contains("{") {
      break
    }
    fixed.append(part)
  }
  if fixed.length == parts.length {
    if exists(pattern) and not is_dir(pattern) {
      return [pattern]
    }
    return []
  }
  var dir = fixed.join("/")
  if dir.is_empty() {
    dir = if pattern.starts_with("/") { "/" } else { "." }
  }
  if not is_dir(dir) {
    return []
  }
  return (try walk(dir)).filter(f => path.matches(f, pattern: pattern))
}
// Deletes a file or an empty directory.
pub fn delete(path: String) throws
// Deletes a file, or a directory with everything in it (like `rm -rf`).
// Nothing at `path` is fine.
pub fn delete_all(path: String) throws
// What `info` tells about a file or directory.
pub type FileInfo {
  // in bytes
  size: Int
  // Unix permissions: 420 is rw-r--r-- (0644), 493 is rwxr-xr-x (0755)
  mode: Int
  // the last change, in seconds since 1970 (`time.from_unix` for a date)
  modified: Int
  is_dir: Bool
}

// The size, permissions and time of the last change of a file or directory
// (following symlinks).
pub fn info(file_path: String) throws -> FileInfo {
  let f = try __stat(file_path)
  return FileInfo(size: f[0], mode: f[1], modified: f[2], is_dir: f[3] == 1)
}

fn __stat(path: String) throws -> List<Int>

// Creates a directory and any missing parents.
pub fn make_dir(path: String) throws
pub fn copy(from: String, to: String) throws
pub fn rename(from: String, to: String) throws
// Working with the text of paths: see the `path` module.

// A file as a stream (see the `io` module), for reading or writing it
// piece by piece: `with f = try files.open(path) { ... }`.
pub fn open(path: String) throws -> io.Stream
// Creates (or empties) a file for writing.
pub fn create(path: String) throws -> io.Stream
// Opens a file for writing at its end, creating it if needed.
pub fn open_append(path: String) throws -> io.Stream

// A new empty directory, deleted with everything in it at the end of `with`.
pub builtin type TempDir {
  path: String
  fn close(self) throws
}

pub fn temp_dir() throws -> TempDir
