// http: a server and a client.
//
//   fn get_note(req: http.Request) throws -> http.Response {
//     let id = try (req.param("id") ?? "").to_int()
//     return http.json(200, note)
//   }
//
//   var router = http.Router()
//   router.get("/notes/:id", get_note)
//   try http.serve(router, port: 8080)
//
// Every request runs in its own task. An error thrown by a handler becomes a
// 500 response (and a log line); a bug in a handler also ends only that
// request.

import crypto
import io
import json
import log
import net
import time

pub type Request {
  method: String
  // without the query: "/notes/7"
  path: String
  // header names in lower case
  headers: Map<String, String>
  body: Bytes
  // from the route pattern: "/notes/:id" gives "id"
  params: Map<String, String> = {}
  // from "?q=word&page=2"; a name given twice keeps its last value (all
  // of them: `query_all`)
  query_params: Map<String, String> = {}
  // the path as sent, still %-encoded: "/files/a%2Fb"
  raw_path: String = ""
  // the query as sent, without "?": "q=a+b&tag=x&tag=y"
  raw_query: String = ""
  // the client's address: "203.0.113.5", "2001:db8::1" (behind a proxy,
  // the proxy's; see the "x-forwarded-for" header)
  client_ip: String = ""

  // A part of the path matched by `:name` in the route.
  pub fn param(self, name: String) -> String? {
    return self.params[name]
  }

  // A value from the query: `?page=2` gives query("page") == "2".
  pub fn query(self, name: String) -> String? {
    return self.query_params[name]
  }

  // Every value of a query parameter given several times:
  // `?tag=a&tag=b` gives ["a", "b"].
  pub fn query_all(self, name: String) -> List<String> {
    var out: List<String> = []
    for pair in self.raw_query.split("&") {
      let kv = pair.split("=")
      let key = try __url_decode(kv[0]) catch err {
        continue
      }
      if key == name {
        let value = if kv.length > 1 { pair.slice(from: kv[0].length + 1, to: pair.length) } else { "" }
        out.append(try __url_decode(value) catch err {
          value
        })
      }
    }
    return out
  }

  // A header, by its name in any case.
  pub fn header(self, name: String) -> String? {
    return self.headers[name.lower()]
  }

  // The body as text; an error if it isn't valid UTF-8.
  pub fn text(self) throws -> String {
    return try self.body.text()
  }

  // A cookie the client sent.
  pub fn cookie(self, name: String) -> String? {
    for part in (self.header("cookie") ?? "").split(";") {
      let kv = part.trim().split("=")
      if kv.length >= 2 and kv[0] == name {
        return kv.drop(1).join("=")
      }
    }
    return none
  }

  // The fields of an HTML form (application/x-www-form-urlencoded).
  // For forms with files, see `parts`.
  pub fn form(self) throws -> Map<String, String> {
    var out: Map<String, String> = {}
    for pair in (try self.text()).split("&") {
      if pair.is_empty() {
        continue
      }
      let kv = pair.split("=")
      out[try __url_decode(kv[0].replace("+", " "))] = try __url_decode(kv.drop(1).join("=").replace("+", " "))
    }
    return out
  }

  // The parts of a multipart/form-data body: form fields and uploaded
  // files. A field has `filename` none; `text()` reads its value.
  pub fn parts(self) throws -> List<Part> {
    let kind = self.header("content-type") ?? ""
    let marker = kind.split("boundary=")
    if not kind.starts_with("multipart/") or marker.length < 2 {
      throw Failure(message: "http: the body isn't multipart/form-data")
    }
    let boundary = "--${marker[1].split(";")[0].trim().replace("\"", "")}".bytes()
    var rest = self.body
    var out: List<Part> = []
    let start = rest.index_of(boundary) ?? throw Failure(message: "http: the multipart body has no boundary")
    rest = rest.slice(from: start + boundary.length, to: rest.length)
    while true {
      // after a boundary: "--" ends the body, "\r\n" starts a part
      if rest.length >= 2 and rest.slice(from: 0, to: 2) == "--".bytes() {
        break
      }
      let head_end = rest.index_of("\r\n\r\n".bytes()) ?? throw Failure(message: "http: a multipart part has no end of headers")
      let head = try rest.slice(from: 2, to: head_end).text()
      let body_start = head_end + 4
      let next = rest.slice(from: body_start, to: rest.length).index_of(boundary) ?? throw Failure(message: "http: a multipart part has no end")
      // the data ends before "\r\n" + boundary
      let data = rest.slice(from: body_start, to: body_start + next - 2)
      var part = Part(name: "", data: data)
      for line in head.split("\r\n") {
        let lower = line.lower()
        if lower.starts_with("content-disposition:") {
          for item in line.split(";").drop(1) {
            let kv = item.trim().split("=")
            if kv.length >= 2 {
              let value = kv.drop(1).join("=").replace("\"", "")
              if kv[0] == "name" {
                part.name = value
              } else if kv[0] == "filename" {
                part.filename = value
              }
            }
          }
        } else if lower.starts_with("content-type:") {
          part.content_type = line.slice(from: 13, to: line.length).trim()
        }
      }
      out.append(part)
      rest = rest.slice(from: body_start + next + boundary.length, to: rest.length)
    }
    return out
  }
}

// A part of a multipart form: a field or an uploaded file.
pub type Part {
  name: String
  // the file's name, for uploads
  filename: String? = none
  content_type: String = "text/plain"
  data: Bytes

  pub fn text(self) throws -> String {
    return try self.data.text()
  }
}

// A cookie to set with `Response.with_cookie`.
pub type Cookie {
  name: String
  value: String
  // seconds until it expires; none: when the browser closes; 0: delete it now
  max_age: Int? = none
  path: String = "/"
  // not readable from JavaScript
  http_only: Bool = true
  // only over HTTPS
  secure: Bool = false
  // "Lax", "Strict" or "None"
  same_site: String = "Lax"
  // also for subdomains of this one: "example.com"; empty: only this host
  domain: String = ""
}

// What a cookie's name, value or attribute may hold: characters that would
// end it or start another attribute (`;`, `,`, spaces, quotes, control
// characters) are dropped, as browsers and Go do. Encode such values
// first (`url.encode`, `encoding.base64`).
fn cookie_safe(text: String) -> String {
  var out = ""
  for c in text.chars() {
    let code = c.bytes()[0]
    if c.byte_length() == 1 and code > 32 and code < 127 and c != ";" and c != "," and c != "\"" and c != "\\" {
      out = "${out}${c}"
    }
  }
  return out
}

// How long a client request took, each from its start. Connections are
// reused between requests (keep-alive), so `connect` is often zero.
pub type Timing {
  dns: time.Duration = time.nanos(0)
  connect: time.Duration = time.nanos(0)
  tls: time.Duration = time.nanos(0)
  // the answer's first byte arrived
  first_byte: time.Duration = time.nanos(0)
  total: time.Duration = time.nanos(0)
  // true if the request went over an already open connection
  reused: Bool = false
}

pub type Response {
  status: Int
  body: Bytes
  headers: Map<String, String> = {}
  // When set, the server sends this file as the body (see `file`).
  file: String = ""
  // When set, the server calls it to write the body (see `stream`).
  writer: (fn(io.Stream) throws)? = none
  // Client responses: how long the parts of the request took.
  timing: Timing = Timing()

  // The body as text; an error if it isn't valid UTF-8.
  pub fn text(self) throws -> String {
    return try self.body.text()
  }

  // A copy with one more header.
  pub fn with_header(self, name: String, value: String) -> Response {
    var r = self
    // one header per name, in any case
    r.headers[name.lower()] = value
    return r
  }

  // A copy that sets a cookie (several can be set).
  pub fn with_cookie(self, cookie: Cookie) -> Response {
    var line = "${cookie_safe(cookie.name).replace("=", "")}=${cookie_safe(cookie.value)}; Path=${cookie_safe(cookie.path)}; SameSite=${cookie_safe(cookie.same_site)}"
    if not cookie.domain.is_empty() {
      line = "${line}; Domain=${cookie_safe(cookie.domain)}"
    }
    if cookie.max_age is some(age) {
      line = "${line}; Max-Age=${age}"
    }
    if cookie.http_only {
      line = "${line}; HttpOnly"
    }
    if cookie.secure {
      line = "${line}; Secure"
    }
    var r = self
    // several Set-Cookie headers travel as lines of one value
    r.headers["set-cookie"] = if r.headers["set-cookie"] is some(old) { "${old}\n${line}" } else { line }
    return r
  }

  // The cookies a client response sets, as name -> value.
  pub fn cookies(self) -> Map<String, String> {
    var out: Map<String, String> = {}
    for line in (self.headers["set-cookie"] ?? "").split("\n") {
      let kv = line.split(";")[0].split("=")
      if kv.length >= 2 {
        out[kv[0].trim()] = kv.drop(1).join("=")
      }
    }
    return out
  }
}

pub fn text(status: Int, body: String) -> Response {
  return Response(status: status, body: body.bytes(), headers: {"content-type": "text/plain; charset=utf-8"})
}

pub fn html(status: Int, body: String) -> Response {
  return Response(status: status, body: body.bytes(), headers: {"content-type": "text/html; charset=utf-8"})
}

// The value as JSON (see the `json` module).
pub fn json<T>(status: Int, value: T) -> Response {
  return Response(status: status, body: json.encode(value).bytes(), headers: {"content-type": "application/json"})
}

// Any bytes: `http.bytes(200, data: png, content_type: "image/png")`.
pub fn bytes(status: Int, data: Bytes, content_type: String) -> Response {
  return Response(status: status, body: data, headers: {"content-type": content_type})
}

// A body written piece by piece while the client already receives it:
// live events, big exports. Each write reaches the client at once.
//
//   fn events(req: http.Request) throws -> http.Response {
//     return http.stream(200, content_type: "text/event-stream", writer: send_ticks)
//   }
//
//   fn send_ticks(out: io.Stream) throws {
//     for i in 0..<10 {
//       try out.write_text("data: tick ${i}\n\n")
//       try time.sleep(time.seconds(1))
//     }
//   }
//
// The writer runs after the status and headers are sent, so an error in it
// can't become a 500: it is logged and the connection is cut. When the
// client goes away, the next write fails, which ends the writer.
pub fn stream(status: Int, content_type: String, writer: fn(io.Stream) throws) -> Response {
  return Response(status: status, body: Bytes(), headers: {"content-type": content_type}, writer: writer)
}

pub fn redirect(to: String) -> Response {
  return Response(status: 302, body: Bytes(), headers: {"location": to})
}

// A file from the disk. The server sends it straight from the disk
// (sendfile), whatever its size; sets the content type from the extension;
// answers 304 when the client has this version cached and serves parts
// (`Range`) for resuming downloads and video. 404 if there is no such file;
// for a directory, its index.html.
pub fn file(path: String) -> Response {
  return Response(status: 200, body: Bytes(), file: path)
}

type Route {
  method: String
  parts: List<String>
  handler: fn(Request) throws -> Response
}

// Runs around every request: gets the request and `next` (the rest of the
// chain: other middleware, then the route) and returns a response.
//   router.use((req, next) => {
//     if req.header("authorization") is none { http.text(401, "log in") } else { try next(req) }
//   })
pub type Middleware = fn(Request, fn(Request) throws -> Response) throws -> Response

pub type Router {
  routes: List<Route> = []
  middleware: List<Middleware> = []

  // Adds middleware: the first added runs first (outermost).
  pub mutating fn use(m: Middleware) {
    self.middleware.append(m)
  }

  pub mutating fn get(pattern: String, handler: fn(Request) throws -> Response) {
    self.routes.append(Route(method: "GET", parts: split_path(pattern), handler: handler))
  }

  pub mutating fn post(pattern: String, handler: fn(Request) throws -> Response) {
    self.routes.append(Route(method: "POST", parts: split_path(pattern), handler: handler))
  }

  pub mutating fn put(pattern: String, handler: fn(Request) throws -> Response) {
    self.routes.append(Route(method: "PUT", parts: split_path(pattern), handler: handler))
  }

  pub mutating fn delete(pattern: String, handler: fn(Request) throws -> Response) {
    self.routes.append(Route(method: "DELETE", parts: split_path(pattern), handler: handler))
  }

  pub mutating fn patch(pattern: String, handler: fn(Request) throws -> Response) {
    self.routes.append(Route(method: "PATCH", parts: split_path(pattern), handler: handler))
  }

  // Any other method: add("PROPFIND", pattern: "/dav/*path", handler: ...). HEAD is answered
  // by GET routes and OPTIONS by the router itself unless added here.
  pub mutating fn add(method: String, pattern: String, handler: fn(Request) throws -> Response) {
    self.routes.append(Route(method: method.upper(), parts: split_path(pattern), handler: handler))
  }

  // Every method: any("/anything/*rest", ...).
  pub mutating fn any(pattern: String, handler: fn(Request) throws -> Response) {
    self.routes.append(Route(method: "*", parts: split_path(pattern), handler: handler))
  }

  // A WebSocket endpoint: the connection is upgraded and `handler` talks
  // over it until it returns (the connection then closes).
  //   router.websocket("/chat", ws => try chat(ws))
  pub mutating fn websocket(pattern: String, handler: fn(WebSocket) throws) {
    self.get(pattern, req => try upgrade(req, handler: handler))
  }

  // Serves the files in `dir` under `prefix`: files("/static", dir: "public")
  // answers /static/css/site.css with public/css/site.css. Paths can't leave
  // `dir`, and hidden files (".env", ".git") are not served.
  pub mutating fn files(prefix: String, dir: String) {
    self.get("${prefix}/*path", req => file_in(dir, name: req.param("path") ?? ""))
  }

  // Finds the route for a request and runs its handler: 404 when no route
  // has this path, 405 when one has it for another method. A pattern part
  // `*name` matches the rest of the path. HEAD is answered by GET routes.
  pub fn handle(self, request: Request) throws -> Response {
    if self.middleware.is_empty() {
      return try self.route(request)
    }
    let router = self
    var next: fn(Request) throws -> Response = r => try router.route(r)
    for m in self.middleware.reversed() {
      let inner = next
      next = r => try m(r, inner)
    }
    return try next(request)
  }

  fn route(self, request: Request) throws -> Response {
    // matched on the path as sent, so "%2F" inside a part stays in it
    let raw = if request.raw_path.is_empty() { request.path } else { request.raw_path }
    let parts = split_path(raw)
    var allowed: List<String> = []
    for route in self.routes {
      let rest = route.parts.any(p => p.starts_with("*"))
      if rest and parts.length < route.parts.length - 1 {
        continue
      }
      if not rest and route.parts.length != parts.length {
        continue
      }
      var params: Map<String, String> = {}
      var same = true
      for i in 0..<route.parts.length {
        let p = route.parts[i]
        if p.starts_with("*") {
          params[p.slice(from: 1, to: p.length)] = parts.drop(i).map(x => __path_decode(x)).join("/")
          break
        }
        if p.starts_with(":") {
          params[p.slice(from: 1, to: p.length)] = __path_decode(parts[i])
        } else if p != __path_decode(parts[i]) {
          same = false
          break
        }
      }
      if not same {
        continue
      }
      let fits = route.method == "*" or route.method == request.method or (request.method == "HEAD" and route.method == "GET")
      if not fits {
        if not allowed.contains(route.method) {
          allowed.append(route.method)
        }
        continue
      }
      var req = request
      req.params = params
      let handler = route.handler
      return try handler(req)
    }
    if allowed.is_empty() {
      return text(404, "not found")
    }
    if allowed.contains("GET") and not allowed.contains("HEAD") {
      allowed.append("HEAD")
    }
    allowed.append("OPTIONS")
    let allow = allowed.join(", ")
    if request.method == "OPTIONS" {
      return Response(status: 204, body: Bytes()).with_header("allow", allow)
    }
    return text(405, "method not allowed").with_header("allow", allow)
  }
}

fn split_path(path: String) -> List<String> {
  return path.split("/").filter(p => not p.is_empty())
}

fn file_in(dir: String, name: String) -> Response {
  let parts = name.split("/")
  // "..", ".env", ".git": nothing outside `dir`, nothing hidden
  if parts.any(p => p.starts_with(".")) {
    return text(404, "not found")
  }
  return file("${dir}/${parts.filter(p => not p.is_empty()).join("/")}")
}

// Middleware that logs each request: "GET /notes/7 200 1.2ms".
pub fn log_requests() -> Middleware {
  return Middleware((req, next) => try logged(req, next: next))
}

fn logged(req: Request, next: fn(Request) throws -> Response) throws -> Response {
  let start = time.now()
  let res = try next(req) catch err {
    log.info("${req.method} ${req.path} error ${start.elapsed().text()}")
    throw err
  }
  log.info("${req.method} ${req.path} ${res.status} ${start.elapsed().text()}")
  return res
}

// Middleware for calls from web pages on other sites (CORS): answers the
// browser's OPTIONS question and marks responses as allowed for `origins`
// (["*"] for any site).
pub fn cors(origins: List<String>) -> Middleware {
  return Middleware((req, next) => try with_cors(req, next: next, origins: origins))
}

fn with_cors(req: Request, next: fn(Request) throws -> Response, origins: List<String>) throws -> Response {
  let origin = req.header("origin") ?? ""
  let allowed = if origins.contains("*") { "*" } else if origins.contains(origin) { origin } else { "" }
  if req.method == "OPTIONS" {
    var res = Response(status: 204, body: Bytes())
    if not allowed.is_empty() {
      res = res.with_header("access-control-allow-origin", value: allowed)
        .with_header("access-control-allow-methods", value: "GET, POST, PUT, PATCH, DELETE, OPTIONS")
        .with_header("access-control-allow-headers", value: req.header("access-control-request-headers") ?? "content-type, authorization")
        .with_header("access-control-max-age", value: "86400")
    }
    return res
  }
  let res = try next(req)
  if allowed.is_empty() {
    return res
  }
  return res.with_header("access-control-allow-origin", value: allowed).with_header("vary", value: "Origin")
}

// The content type for a file name: "a.png" -> "image/png".
pub fn mime_type(path: String) -> String

fn __url_decode(text: String) throws -> String

// A request for tests: `router.handle(http.request("GET", "/notes/1"))`.
// With a body: `var req = http.request("POST", "/notes")`, then
// `req.body = "{\"title\": \"x\"}".bytes()`.
// The path may have a query: `http.request("GET", "/search?q=x")`.
pub fn request(method: String, path: String) -> Request {
  let q = path.index_of("?")
  let raw_path = if q is some(i) { path.slice(from: 0, to: i) } else { path }
  let raw_query = if q is some(i) { path.slice(from: i + 1, to: path.length) } else { "" }
  var params: Map<String, String> = {}
  for pair in raw_query.split("&") {
    if pair.is_empty() {
      continue
    }
    let kv = pair.split("=")
    let key = try __url_decode(kv[0]) catch err {
      kv[0]
    }
    let value = if kv.length > 1 { pair.slice(from: kv[0].length + 1, to: pair.length) } else { "" }
    params[key] = try __url_decode(value) catch err {
      value
    }
  }
  let decoded = __path_decode(raw_path)
  return Request(method: method, path: decoded, headers: {}, body: Bytes(), query_params: params, raw_path: raw_path, raw_query: raw_query, client_ip: "127.0.0.1")
}

fn __path_decode(path: String) -> String

// The reason phrase of a status code: 404 -> "Not Found"; "" if unknown.
pub fn status_text(status: Int) -> String

// Serves the router until the program is stopped (Ctrl-C), then returns.
// It logs "listening on http://localhost:<port>" when ready, and "stopped".
pub fn serve(router: Router, port: Int) throws {
  try __serve(port, req => try router.handle(req))
}

fn __serve(port: Int, handler: fn(Request) throws -> Response) throws

// How to serve: `http.serve_with(router, options: http.ServerOptions(port: 8080, host: "127.0.0.1"))`.
pub type ServerOptions {
  port: Int = 8080
  // "" for every address; "127.0.0.1" (or "::1") for this machine only
  host: String = ""
  // bigger request bodies are answered with 413
  max_body: Int = 67108864
}

pub fn serve_with(router: Router, options: ServerOptions) throws {
  try __serve_on(options.host, port: options.port, max_body: options.max_body, handler: req => try router.handle(req))
}

fn __serve_on(host: String, port: Int, max_body: Int, handler: fn(Request) throws -> Response) throws

// ---- client (HTTPS works) ----
// A response with any status is not an error: check `response.status`.
// Errors are for failures to talk to the server at all.

// A request to send: http.send(http.ClientRequest(url: u, headers: {...}))
pub type ClientRequest {
  url: String
  method: String = "GET"
  headers: Map<String, String> = {}
  // Without a "content-type" header, one starting with { or [ is sent as
  // JSON, other text as plain text.
  body: Bytes = Bytes()
  // For the whole request, from connecting to the last byte of the body.
  // Streams read for long (http.open) need a long one.
  timeout: time.Duration = time.seconds(60)
  // 3xx answers are followed (at most 10; a POST becomes a GET after
  // 301/302/303, as browsers do). Otherwise the 3xx is the answer.
  follow_redirects: Bool = true
}

pub fn send(request: ClientRequest) throws -> Response {
  if not request.url.contains("://") {
    throw Failure(message: "http: \"${request.url}\" is not a URL: it needs a scheme like https://")
  }
  return try __send(request.method, url: request.url, headers: request.headers, body: request.body, timeout_ms: request.timeout.millis(), follow: request.follow_redirects)
}

pub fn get(url: String) throws -> Response {
  return try send(ClientRequest(url: url))
}

pub fn post(url: String, body: String) throws -> Response {
  return try send(ClientRequest(url: url, method: "POST", body: body.bytes()))
}

pub fn put(url: String, body: String) throws -> Response {
  return try send(ClientRequest(url: url, method: "PUT", body: body.bytes()))
}

pub fn delete(url: String) throws -> Response {
  return try send(ClientRequest(url: url, method: "DELETE"))
}

// Sends a request and returns as soon as the status and headers arrive; the
// body is then read piece by piece: event streams, streamed answers of AI
// APIs, large responses.
//
//   with res = try http.open(http.ClientRequest(url: u)) {
//     while try res.read_line() is some(line) { ... }
//   }
pub fn open(request: ClientRequest) throws -> ResponseStream {
  if not request.url.contains("://") {
    throw Failure(message: "http: \"${request.url}\" is not a URL: it needs a scheme like https://")
  }
  return try __open(request.method, url: request.url, headers: request.headers, body: request.body, timeout_ms: request.timeout.millis(), follow: request.follow_redirects)
}

pub builtin type ResponseStream {
  fn status(self) -> Int
  // A header, by its name in any case.
  fn header(self, name: String) -> String?
  // Reading the body works as for `io.Stream`. An error at the end means
  // the body was cut off.
  fn read(self, max: Int) throws -> Bytes
  fn read_line(self) throws -> String?
  fn read_all(self) throws -> Bytes
  // How long the request took up to the headers (`total` is filled in
  // once the body has been read).
  fn timing(self) -> Timing
  // Stops receiving the rest.
  fn close(self) throws
}

fn __send(method: String, url: String, headers: Map<String, String>, body: Bytes, timeout_ms: Int, follow: Bool) throws -> Response
fn __open(method: String, url: String, headers: Map<String, String>, body: Bytes, timeout_ms: Int, follow: Bool) throws -> ResponseStream

// Saves what `url` answers into the file `to`, without holding it in memory.
// The response has the status and headers and an empty body. The file is
// written only for a 2xx status.
pub fn download(url: String, to: String) throws -> Response

// ---- WebSockets (RFC 6455)

// A WebSocket connection: from `Router.websocket` on a server, or
// `http.websocket(address)` as a client. One task receives; sending from
// another task at the same time is fine for whole messages.
pub type WebSocket {
  conn: io.Stream
  // clients mask what they send (the protocol requires it)
  client: Bool = false

  // The next message; none when the other side has closed. Pings are
  // answered, and messages sent in pieces are joined, along the way.
  pub fn receive(self) throws -> WebSocketMessage? {
    var data = Bytes()
    var is_text = true
    var started = false
    while true {
      let head = try self.conn.read_exact(2) catch err {
        if err is Cancelled {
          throw err
        }
        return none
      }
      let b0 = head.int_at(0, size: 1)
      let b1 = head.int_at(1, size: 1)
      let fin = b0.bit_and(128) != 0
      let op = b0.bit_and(15)
      var length = b1.bit_and(127)
      if length == 126 {
        length = (try self.conn.read_exact(2)).int_at(0, size: 2)
      } else if length == 127 {
        length = (try self.conn.read_exact(8)).int_at(0, size: 8)
      }
      if length > 67108864 {
        throw Failure(message: "websocket: a message over 64 MB")
      }
      let key = if b1.bit_and(128) != 0 { try self.conn.read_exact(4) } else { Bytes() }
      var payload = if length > 0 { try self.conn.read_exact(length) } else { Bytes() }
      if key.length == 4 {
        payload = __ws_mask(payload, key: key)
      }
      if op == 8 {
        // the other side is closing: answer and stop
        try self.frame(8, data: payload.slice(from: 0, to: min(2, payload.length))) catch err {
        }
        return none
      }
      if op == 9 {
        try self.frame(10, data: payload)
        continue
      }
      if op == 10 {
        continue
      }
      if op == 1 or op == 2 {
        started = true
        is_text = op == 1
        data = payload
      } else if op == 0 and started {
        data.append_all(payload)
      } else {
        throw Failure(message: "websocket: an unexpected frame (opcode ${op})")
      }
      if fin {
        return WebSocketMessage(data: data, is_text: is_text)
      }
    }
    return none
  }

  pub fn send_text(self, text: String) throws {
    try self.frame(1, data: text.bytes())
  }

  pub fn send(self, data: Bytes) throws {
    try self.frame(2, data: data)
  }

  // Says goodbye and closes the connection.
  pub fn close(self) throws {
    try self.frame(8, data: Bytes([3, 232])) catch err {
    }
    try self.conn.close()
  }

  fn frame(self, op: Int, data: Bytes) throws {
    var f = Bytes()
    f.append(128 + op)
    let mask = if self.client { 128 } else { 0 }
    if data.length < 126 {
      f.append(mask + data.length)
    } else if data.length < 65536 {
      f.append(mask + 126)
      f.append_int(data.length, size: 2)
    } else {
      f.append(mask + 127)
      f.append_int(data.length, size: 8)
    }
    if self.client {
      let key = crypto.random_bytes(4)
      f.append_all(key)
      f.append_all(__ws_mask(data, key: key))
    } else {
      f.append_all(data)
    }
    try self.conn.write(f)
  }
}

pub type WebSocketMessage {
  data: Bytes
  // text (UTF-8) or binary
  is_text: Bool

  pub fn text(self) throws -> String {
    return try self.data.text()
  }
}

fn upgrade(req: Request, handler: fn(WebSocket) throws) throws -> Response {
  let key = req.header("sec-websocket-key") ?? ""
  if (req.header("upgrade") ?? "").lower() != "websocket" or key.is_empty() {
    return text(400, "this address takes WebSocket connections")
  }
  let accept = __sha1("${key}258EAFA5-E914-47DA-95CA-C5AB0DC85B11".bytes()).base64()
  return Response(status: 101, body: Bytes(), headers: {"upgrade": "websocket", "sec-websocket-accept": accept}, writer: stream => try run_websocket(stream, handler: handler))
}

fn run_websocket(stream: io.Stream, handler: fn(WebSocket) throws) throws {
  with ws = WebSocket(conn: stream) {
    try handler(ws)
  }
}

// Connects to a WebSocket server: "ws://host:port/path" or "wss://..." (TLS).
//   with ws = try http.websocket("wss://echo.example/socket") {
//     try ws.send_text("hi")
//     if try ws.receive() is some(m) {
//       print(try m.text())
//     }
//   }
pub fn websocket(address: String) throws -> WebSocket {
  let parts = address.split("://")
  if parts.length != 2 or (parts[0] != "ws" and parts[0] != "wss") {
    throw Failure(message: "websocket: \"${address}\" isn't a ws:// or wss:// address")
  }
  let secure = parts[0] == "wss"
  let rest = parts[1]
  let slash = rest.index_of("/") ?? rest.length
  let authority = rest.slice(from: 0, to: slash)
  let path = if slash < rest.length { rest.slice(from: slash, to: rest.length) } else { "/" }
  let hp = authority.split(":")
  let host = hp[0]
  let port = if hp.length > 1 { try hp[1].to_int() } else if secure { 443 } else { 80 }
  with ws = WebSocket(conn: try connect_to(host, port: port, secure: secure), client: true) {
    let key = crypto.random_bytes(16).base64()
    try ws.conn.write_text("GET ${path} HTTP/1.1\r\nHost: ${authority}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: ${key}\r\nSec-WebSocket-Version: 13\r\n\r\n")
    let status = try ws.conn.read_line() ?? ""
    if not status.contains(" 101") {
      throw Failure(message: "websocket: ${address} answered \"${status}\" instead of switching protocols")
    }
    var accepted = ""
    while try ws.conn.read_line() is some(line) {
      if line.is_empty() {
        break
      }
      if line.lower().starts_with("sec-websocket-accept:") {
        accepted = line.slice(from: 21, to: line.length).trim()
      }
    }
    if accepted != __sha1("${key}258EAFA5-E914-47DA-95CA-C5AB0DC85B11".bytes()).base64() {
      throw Failure(message: "websocket: ${address} didn't accept the handshake")
    }
    return ws
  }
}

fn connect_to(host: String, port: Int, secure: Bool) throws -> io.Stream {
  if secure {
    return try net.connect_tls(host, port: port)
  }
  return try net.connect(host, port: port)
}

fn __sha1(data: Bytes) -> Bytes
fn __ws_mask(data: Bytes, key: Bytes) -> Bytes
