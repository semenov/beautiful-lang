// url: parts of URLs, and percent-encoding.

pub type Url {
  scheme: String
  host: String
  port: Int?
  path: String
  query: Map<String, String>
  fragment: String?
  // "postgres://ada:secret@db:5432/app": "ada" and "secret" (decoded)
  user: String? = none
  password: String? = none
}

// "https://example.com:8080/a/b?x=1#top". Relative references parse too,
// with an empty scheme and host: "/a/b?x=1", "b/c", "//cdn.example/x".
pub fn parse(text: String) throws -> Url {
  let scheme_end = text.split("://")
  var scheme = ""
  var rest = text
  var has_authority = false
  if scheme_end.length >= 2 and is_scheme(scheme_end[0]) {
    scheme = scheme_end[0].lower()
    rest = scheme_end.drop(1).join("://")
    has_authority = true
  } else if text.starts_with("//") {
    rest = text.slice(from: 2, to: text.length)
    has_authority = true
  }
  var fragment: String? = none
  let hash_parts = rest.split("#")
  if hash_parts.length > 1 {
    fragment = hash_parts.drop(1).join("#")
    rest = hash_parts[0]
  }
  var query: Map<String, String> = {}
  let q_parts = rest.split("?")
  if q_parts.length > 1 {
    for pair in q_parts.drop(1).join("?").split("&") {
      if pair.is_empty() {
        continue
      }
      let kv = pair.split("=")
      query[try decode(kv[0])] = try decode(kv.drop(1).join("="))
    }
    rest = q_parts[0]
  }
  if not has_authority {
    return Url(scheme: "", host: "", port: none, path: rest, query: query, fragment: fragment)
  }
  let slash = rest.split("/")
  var authority = slash[0]
  var user: String? = none
  var password: String? = none
  let at = authority.split("@")
  if at.length > 1 {
    let info = at.take(at.length - 1).join("@").split(":")
    user = try decode(info[0])
    if info.length > 1 {
      password = try decode(info.drop(1).join(":"))
    }
    authority = at[at.length - 1]
  }
  let full_path = if slash.length > 1 { "/${slash.drop(1).join("/")}" } else { "/" }
  var host = authority
  var port: Int? = none
  let colon = authority.split(":")
  if colon.length == 2 {
    host = colon[0]
    port = try colon[1].to_int() catch err {
      throw Failure(message: "url: bad port in \"${text}\"")
    }
  }
  return Url(scheme: scheme, host: host.lower(), port: port, path: full_path, query: query, fragment: fragment, user: user, password: password)
}

fn is_scheme(s: String) -> Bool {
  if s.is_empty() or not s.slice(from: 0, to: 1).is_letter() {
    return false
  }
  return s.chars().all(c => c.is_letter() or c.is_digit() or c == "+" or c == "-" or c == ".")
}

// A reference resolved against the page it's on, as browsers do (RFC 3986):
// resolve("https://a.example/docs/x.html?q=1", reference: "../img/b.png")
// is "https://a.example/img/b.png".
pub fn resolve(base: String, reference: String) -> String {
  let ref_scheme = reference.split("://")
  if ref_scheme.length >= 2 and is_scheme(ref_scheme[0]) {
    return reference
  }
  let parts = base.split("://")
  if parts.length < 2 {
    return reference
  }
  let scheme = parts[0]
  let after = parts.drop(1).join("://")
  let slash = after.index_of("/") ?? after.length
  let q = after.index_of("?") ?? after.length
  let h = after.index_of("#") ?? after.length
  let auth_end = min(slash, min(q, h))
  let origin = "${scheme}://${after.slice(from: 0, to: auth_end)}"
  let path_end = min(q, h)
  let path = if auth_end < path_end { after.slice(from: auth_end, to: path_end) } else { "/" }
  let no_fragment = after.slice(from: 0, to: h)
  if reference.is_empty() {
    return "${scheme}://${no_fragment}"
  }
  if reference.starts_with("//") {
    return "${scheme}:${reference}"
  }
  if reference.starts_with("#") {
    return "${scheme}://${no_fragment}${reference}"
  }
  if reference.starts_with("?") {
    return "${origin}${path}${reference}"
  }
  // the reference's path, and what follows it
  let rq = reference.index_of("?") ?? reference.length
  let rh = reference.index_of("#") ?? reference.length
  let ref_path = reference.slice(from: 0, to: min(rq, rh))
  let tail = reference.slice(from: min(rq, rh), to: reference.length)
  let merged = if ref_path.starts_with("/") { ref_path } else { "${path.slice(from: 0, to: (path.last_index_of("/") ?? -1) + 1)}${ref_path}" }
  return "${origin}${remove_dots(merged)}${tail}"
}

// "/a/b/../c/./d" -> "/a/c/d"
fn remove_dots(path: String) -> String {
  var out: List<String> = []
  let segs = path.split("/")
  for s in segs.indexed() {
    if s.value == "." {
      if s.index == segs.length - 1 {
        out.append("")
      }
    } else if s.value == ".." {
      if out.length > 1 {
        out = out.take(out.length - 1)
      }
      if s.index == segs.length - 1 {
        out.append("")
      }
    } else {
      out.append(s.value)
    }
  }
  let joined = out.join("/")
  return if joined.starts_with("/") { joined } else { "/${joined}" }
}

// Percent-encodes text for a URL part: "a b&c" -> "a%20b%26c"
pub fn encode(text: String) -> String

// "a%20b" -> "a b"
pub fn decode(text: String) throws -> String

// {"q": "a b", "page": "2"} -> "q=a%20b&page=2"
pub fn query_text(params: Map<String, String>) -> String {
  return params.entries().map(e => "${encode(e.key)}=${encode(e.value)}").join("&")
}
