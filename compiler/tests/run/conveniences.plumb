import env
import files
import log
import process
import random

fn main() throws {
  try files.write("/tmp/plumb-env-test", "# comment\nexport A=1\nB=\"two\\nlines\"\nC=plain # note\nPATH=nope\n")
  try env.load("/tmp/plumb-env-test")
  try env.load("missing.env")
  print("${env.get("A") ?? "-"} | ${env.get("B") ?? "-"} | ${env.get("C") ?? "-"} | path kept: ${(env.get("PATH") ?? "") != "nope"}")
  print("sh found: ${process.find("sh") is some(_)}; nope: ${process.find("surely-not-a-program")}")
  let out = try process.run_command(process.Command(program: "sh", args: ["-c", "pwd; echo $GREETING; cat"], dir: "/", env: {"GREETING": "hello"}, input: "from stdin"))
  print(out.stdout.trim())
  let big = "x".repeat(300000)
  let wc = try process.run_command(process.Command(program: "wc", args: ["-c"], input: big))
  print("wc: ${wc.stdout.trim()}")
  print("${[1, 2, 2, 3, 1].unique()} ${[1, 2, 3, 4, 5].chunks(2)} ${[[1], [2, 3]].flat_map(x => x)} ${[5, 6].index_of(6)} ${[5, 6].find_index(x => x > 9)}")
  let p = [1, 2, 3, 4].partition(x => x % 2 == 0)
  print("${p.matching} ${p.rest}")
  let a = random.uuid_v7()
  let b = random.uuid_v7()
  print("${a.length} v7: ${a.slice(from: 14, to: 15)} ordered: ${a < b or a.slice(from: 0, to: 13) == b.slice(from: 0, to: 13)}")
  log.debug("hidden")
  log.info("shown")
}
