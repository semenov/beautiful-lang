import time

fn main() throws {
  let moment = try time.parse_iso("2026-09-29T14:05:09Z")
  let berlin = try moment.in_zone("Europe/Berlin")
  print("${berlin.iso()} ${berlin.abbreviation} ${berlin.format("%H:%M %Z (%z)")}")
  let ny = try moment.in_zone("America/New_York")
  print("${ny.iso()} ${ny.abbreviation}")
  let winter = try time.parse_iso("2026-01-15T12:00:00Z")
  print("${(try winter.in_zone("Europe/Berlin")).iso()} ${(try winter.in_zone("Asia/Tokyo")).iso()}")
  let meeting = try time.in_zone("Europe/Berlin", date: time.Date(year: 2026, month: 3, day: 29), hour: 2, minute: 30)
  print("skipped hour: ${meeting.iso()} = ${(try meeting.in_zone("Europe/Berlin")).iso()}")
  print("round trip: ${berlin.utc().iso()}")
  print("local zone known: ${time.local_zone().length > 0}")
  let _ = try moment.in_zone("Mars/Olympus") catch err {
    print(err.message())
    berlin
  }
}
