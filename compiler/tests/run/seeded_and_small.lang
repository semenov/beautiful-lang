// A seeded generator (SplitMix64, checked against the reference), wrapping
// Int arithmetic, Duration division, the environment, wall-clock millis.
import env
import random
import time

fn main() {
  var r = random.seeded(42)
  let first = [r.next(), r.next()]
  var again = random.seeded(42)
  print("${first} ${[again.next(), again.next()] == first}")
  var dice = random.seeded(7)
  print("${[0, 0, 0, 0, 0].map(x => 0).length} ${dice.between(1, 6)} ${dice.shuffle([1, 2, 3, 4, 5])} ${dice.fraction() < 1.0}")
  print("${0x7fff_ffff_ffff_ffff.wrapping_add(1)} ${3.wrapping_mul(-1)} ${0.wrapping_sub(1)}")
  print("${time.seconds(3).divided_by(2).millis()} ${time.millis(1).is_shorter_than(time.seconds(1))}")
  print("${env.all()["HOME"] != none} ${time.unix_millis() > 1700000000000}")
}
