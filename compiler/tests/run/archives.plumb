import archive
import files
import path
import zlib

fn main() throws {
  let root = "/tmp/plumb-archive-test"
  try files.delete_all(root)
  let long = "long".repeat(30)
  for f in ["src/a.txt", "src/sub/b.txt", "src/${long}/c.txt"] {
    try files.make_dir(path.parent(path.join(root, f)))
    try files.write(path.join(root, f), "content of ${path.name(f)}")
  }
  let entries = try archive.from_dir(path.join(root, "src"))
  for kind in ["tar", "zip"] {
    let data = if kind == "tar" { zlib.gzip(archive.write_tar(entries)) } else { archive.write_zip(entries) }
    let back = if kind == "tar" { try archive.read_tar(try zlib.gunzip(data)) } else { try archive.read_zip(data) }
    let out = path.join(root, "out-${kind}")
    try archive.extract(back, to: out)
    let names = (try files.walk(out)).map(f => f.slice(from: out.length + 1, to: f.length))
    print("${kind}: ${names.map(n => if n.length > 20 { "${n.slice(from: 0, to: 8)}...${path.name(n)}" } else { n })} ${try files.read(path.join(out, "sub/b.txt"))}")
  }
  // written piece by piece, compressed, and read back
  let streamed = path.join(root, "streamed.tar.gz")
  with tar = try archive.create_tar(streamed) {
    try tar.add_dir(path.join(root, "src"), name: "site")
    try tar.add(archive.Entry(name: "extra.txt", data: "extra".bytes()))
  }
  let got = try archive.read_tar(try zlib.gunzip(try files.read_bytes(streamed)))
  print("streamed: ${got.filter(e => not e.name.contains("...")).map(e => "${e.name}${if e.is_dir { "/" } else { "" }}").filter(n => n.length < 30)}")
  try archive.extract([archive.Entry(name: "a/../../x", data: Bytes())], to: path.join(root, "out")) catch err {
    print(err.message().replace(root, "ROOT"))
  }
  try files.delete_all(root)
}
