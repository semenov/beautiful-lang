import files
import path

fn short(root: Text, found: List<Text>) -> List<Text> {
  return found.map(f => f.slice(from: root.length + 1, to: f.length))
}

fn main() throws {
  let root = "/tmp/lang-glob-test"
  try files.delete_all(root)
  for f in ["src/a.lang", "src/b.txt", "src/net/tcp.lang", "src/net/deep/x.lang", "logs/2026-01.log", "logs/2026-02.gz", "logs/2025-12.log"] {
    let p = path.join(root, f)
    try files.make_dir(path.parent(p))
    try files.write(p, "")
  }
  print("${short(root, found: try files.walk(root))}")
  print("${short(root, found: try files.glob("${root}/src/**/*.lang"))}")
  print("${short(root, found: try files.glob("${root}/logs/2026-*.{log,gz}"))}")
  print("${path.matches("a/b/c.txt", pattern: "**/*.txt")} ${path.matches("a/c.txt", pattern: "*.txt")} ${path.matches("b.md", pattern: "[a-c].{md,txt}")}")
  try files.delete_all(root)
  print("gone: ${not files.exists(root)}")
}
