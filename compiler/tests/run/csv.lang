type Person {
  name: Text
  age: Int
}

type BadHeader implements Error {
  actual: Text

  fn message(self) -> Text {
    return "expected header \"name,age\", got \"${self.actual}\""
  }
}

fn parse_people(text: Text) throws -> List<Person> {
  let lines = text.lines()
  let header = lines.first() ?? throw Failure(message: "the CSV is missing its header line")
  if header != "name,age" {
    throw BadHeader(actual: header)
  }
  var people: List<Person> = []
  for line in lines.drop(1) {
    let columns = line.split(",")
    if columns.length != 2 {
      continue
    }
    let age = try columns[1].trim().to_int() catch err {
      continue
    }
    people.append(Person(name: columns[0], age: age))
  }
  return people
}

test "parses valid rows and skips malformed ones" {
  let people = try parse_people("name,age\nAda,36\nAlan,41\nBad,row,extra\nEve,notanumber")
  expect people.length == 2
  expect people[1].name == "Alan"
}

test "a wrong header is an error" {
  let err = expect throws parse_people("id,age\nAda,36")
  expect err is BadHeader
  if err is BadHeader {
    expect err.actual == "id,age"
  }
}

fn main() throws {
  let people = try parse_people("name,age\nAda,36\nAlan,41\nGrace,x")
  for person in people {
    print("${person.name} is ${person.age}")
  }
  let result = try parse_people("nope") catch err {
    print("error: ${err.message()}")
    []
  }
  print("got ${result.length} people")
}
