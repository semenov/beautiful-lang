import http

fn chat(ws: http.WebSocket) throws {
  try ws.send_text("welcome")
  while try ws.receive() is some(msg) {
    if msg.is_text {
      try ws.send_text("echo: ${try msg.text()}")
    } else {
      try ws.send(msg.data)
    }
  }
}

fn main() throws {
  var router = http.Router()
  router.websocket("/chat", ws => try chat(ws))
  router.get("/", req => http.text(200, "hi"))
  try http.serve(router, port: 8116)
}
