import cli
import process

type AddOptions {
  name: String
  force: Bool = false
}

type ListOptions {
  all: Bool = false
  limit: Int = 10
}

fn main() throws {
  let args = process.args()
  match args.first() ?? "" {
    "add" => {
      let o = try cli.decode_from<AddOptions>(args.drop(1))
      print("add ${o.name} force=${o.force}")
    }
    "list" => {
      let o = try cli.decode_from<ListOptions>(args.drop(1))
      print("list all=${o.all} limit=${o.limit}")
    }
    _ => {
      eprint("usage: tool add --name N [--force] | list [--all] [-limit N]")
      process.exit(2)
    }
  }
}
