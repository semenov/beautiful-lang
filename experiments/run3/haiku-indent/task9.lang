import files

interface Listable
  fn list_keys(self) -> List<String>

interface Storage
  fn get(self, key: String) -> String?
  fn put(var self, key: String, value: String)
  fn delete(var self, key: String)

type MemoryStorage implements Storage, Listable
  data: Map<String, String> = {}

  fn get(self, key: String) -> String?
    return self.data[key]

  fn put(var self, key: String, value: String)
    self.data[key] = value

  fn delete(var self, key: String)
    self.data.remove(key)

  fn list_keys(self) -> List<String>
    return self.data.keys()

type FileStorage implements Storage, Listable
  directory: String

  fn get(self, key: String) -> String?
    let path = "${self.directory}/${key}"
    if files.exists(path)
      let content = try files.read(path) catch err
        return none
      return content
    else
      return none

  fn put(var self, key: String, value: String)
    let path = "${self.directory}/${key}"
    try files.write(path, value)

  fn delete(var self, key: String)
    let path = "${self.directory}/${key}"
    try files.delete(path)

  fn list_keys(self) -> List<String>
    let all_files = try files.list(self.directory) catch err
      return []
    return all_files

fn copy_with_prefix(var source: MemoryStorage, var dest: FileStorage, prefix: String)
  let keys = source.list_keys()

  for key in keys
    if key.starts_with(prefix)
      if source.get(key) is some(value)
        dest.put(key: key, value: value)

fn main() throws
  var memory: MemoryStorage = MemoryStorage()
  var file: FileStorage = FileStorage(directory: "/tmp/storage")

  memory.put(key: "user:1", value: "Alice")
  memory.put(key: "user:2", value: "Bob")
  memory.put(key: "config:debug", value: "true")

  copy_with_prefix(&memory, &file, "user:")

  let copied = file.get("user:1")
  if copied is some(v)
    print("Copied: ${v}")

test "memory storage get and put"
  var storage = MemoryStorage()
  storage.put(key: "name", value: "Ada")
  let value = storage.get("name")
  expect value is some("Ada")

test "memory storage delete"
  var storage = MemoryStorage()
  storage.put(key: "key", value: "value")
  storage.delete("key")
  expect storage.get("key") is none

test "memory storage list_keys"
  var storage = MemoryStorage()
  storage.put(key: "a", value: "1")
  storage.put(key: "b", value: "2")
  let keys = storage.list_keys()
  expect keys.length == 2
  expect keys.contains("a")
