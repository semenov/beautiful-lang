import http
import json
import time
import tasks

type GitHubUser
  login: String
  name: String? = none
  bio: String? = none

fn format_user(user: GitHubUser?) -> String
  if user is some(u)
    let name_text = u.name ?? "(no name)"
    let bio_text = u.bio ?? "(no bio)"
    return "${u.login}: ${name_text} - ${bio_text}"
  else
    return "(failed to fetch user)"

fn fetch_user(username: String) throws -> GitHubUser
  let url = "https://api.github.com/users/${username}"
  let response = try http.get(url)
  let user = try json.decode<GitHubUser>(response.body)
  return user

fn main() throws
  let usernames = ["golang", "torvalds", "gvanrossum"]

  try time.timeout(time.seconds(5), () =>
    with group = try tasks.group()
      var tasks_list: List<tasks.Task<GitHubUser?>> = []

      for username in usernames
        let task = group.run(() =>
          try fetch_user(username) catch err
            none
        )
        tasks_list.append(task)

      for task in tasks_list
        let user = try task.wait()
        print(format_user(user))
  )

test "format_user with complete data"
  let user = GitHubUser(login: "ada", name: "Ada Lovelace", bio: "Mathematician")
  let formatted = format_user(user)
  expect formatted.contains("ada")
  expect formatted.contains("Ada Lovelace")

test "format_user with missing data"
  let user = GitHubUser(login: "mystery")
  let formatted = format_user(user)
  expect formatted.contains("mystery")
  expect formatted.contains("no name")

test "format_user with none"
  let formatted = format_user(none)
  expect formatted.contains("failed")
