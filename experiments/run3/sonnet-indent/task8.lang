// Task 8: Count ERROR log lines per service, using 4 concurrent workers.

import cli
import files
import tasks

pub type Options
  args: List<Text> = []

pub type ServiceCount
  service: Text
  count: Int

fn bump(counts: var Map<Text, Int>, key: Text)
  counts[key] = (counts[key] ?? 0) + 1

// Pure counting logic, reused by the concurrent pipeline below and easy to
// exercise directly in tests.
fn count_errors(lines: List<Text>) -> Map<Text, Int>
  var counts: Map<Text, Int> = {}
  for line in lines
    if line.contains("ERROR")
      bump(&counts, line.words()[1])
  return counts

fn process_line(line: Text, counts: Shared<Map<Text, Int>>)
  if not line.contains("ERROR")
    return
  let service = line.words()[1]
  counts.update(m =>
    var updated = m
    bump(&updated, service)
    updated
  )

fn report_sorted_by_count(counts: Map<Text, Int>) -> List<ServiceCount>
  let entries = counts.entries().map(e => ServiceCount(service: e.key, count: e.value))
  return entries.sorted_by(e => e.count).reversed()

fn main() throws
  let options = try cli.decode<Options>()
  let path = options.args.first() ?? "app.log"
  let counts = Shared<Map<Text, Int>>({})
  with file = try files.open(path)
    with group = try tasks.group()
      let jobs = Channel<Text>(capacity: 100)
      for worker_index in 0..<4
        group.start(() =>
          for line in jobs
            process_line(line, counts)
        )
      for line in file.lines()
        try jobs.send(line)
      jobs.close()
  for entry in report_sorted_by_count(counts.get())
    print("${entry.service}: ${entry.count}")

test "counts ERROR lines per service"
  let lines = [
    "2024-01-01 auth ERROR timeout",
    "2024-01-01 auth INFO ok",
    "2024-01-01 billing ERROR failed",
    "2024-01-01 billing ERROR failed again"
  ]
  let counts = count_errors(lines)
  expect (counts["auth"] ?? 0) == 1
  expect (counts["billing"] ?? 0) == 2

test "a line without ERROR is ignored"
  let lines = ["2024-01-01 auth INFO ok"]
  let counts = count_errors(lines)
  expect counts.length == 0

test "the report is sorted by count, highest first"
  let counts: Map<Text, Int> = {"auth": 1, "billing": 3, "cache": 2}
  let sorted = report_sorted_by_count(counts)
  expect sorted[0].service == "billing"
  expect sorted[1].service == "cache"
  expect sorted[2].service == "auth"
