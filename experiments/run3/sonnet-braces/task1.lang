// 1. Inventory

type Product {
  name: String
  price: Decimal
  stock: Int
}

fn restock(products: var List<Product>, name: String, amount: Int) {
  for i in 0..<products.length {
    if products[i].name == name {
      products[i].stock += amount
      return
    }
  }
}

fn low_stock_names(products: List<Product>) -> List<String> {
  let low = products.filter(p => p.stock < 5)
  let sorted = low.sorted_by(p => p.stock)
  return sorted.map(p => p.name)
}

fn average_stock(products: List<Product>) -> Float {
  if products.is_empty() {
    return 0.0
  }
  let total = products.map(p => p.stock).sum()
  return total.to_float() / products.length.to_float()
}

test "restock adds to the named product and leaves others alone" {
  var products = [
    Product(name: "Widget", price: 9.99, stock: 3),
    Product(name: "Gadget", price: 19.99, stock: 12)
  ]

  restock(&products, name: "Widget", amount: 10)

  expect products[0].stock == 13
  expect products[1].stock == 12
}

test "low_stock_names sorts ascending and only includes items under 5" {
  let products = [
    Product(name: "A", price: 1.0, stock: 4),
    Product(name: "B", price: 1.0, stock: 1),
    Product(name: "C", price: 1.0, stock: 10)
  ]

  expect low_stock_names(products) == ["B", "A"]
}

test "average_stock computes a fractional average" {
  let products = [
    Product(name: "A", price: 1.0, stock: 2),
    Product(name: "B", price: 1.0, stock: 5)
  ]

  expect average_stock(products) == 3.5
}

test "average_stock of an empty list is zero" {
  let products: List<Product> = []
  expect average_stock(products) == 0.0
}

fn main() {
  var products = [
    Product(name: "Widget", price: 9.99, stock: 3),
    Product(name: "Gadget", price: 19.99, stock: 12),
    Product(name: "Gizmo", price: 4.50, stock: 1)
  ]

  restock(&products, name: "Widget", amount: 10)

  let low = low_stock_names(products)
  print("low stock: ${low.join(", ")}")

  let avg = average_stock(products)
  print("average stock: ${avg}")
}
