# Shapes: area and size description.

enum Shape
  Circle(radius: Float)
  Rectangle(width: Float, height: Float)
  Triangle(base: Float, height: Float)

fn area(shape: Shape) -> Float
  return match shape
    case Circle(r) => PI * r ^ 2
    case Rectangle(w, h) => w * h
    case Triangle(b, h) => b * h / 2

fn total_area(shapes: List<Shape>) -> Float
  return shapes.map(area).sum()

fn describe(shape: Shape) -> Text
  let a = area(shape)
  if a < 10
    return "small"
  else if a < 100
    return "medium"
  else
    return "large"

test "total area sums every shape"
  let shapes = [
    Rectangle(width: 2, height: 3),
    Triangle(base: 4, height: 2),
  ]
  expect total_area(shapes) == 10

test "describe buckets shapes by area"
  expect describe(Rectangle(width: 2, height: 2)) == "small"
  expect describe(Rectangle(width: 5, height: 5)) == "medium"
  expect describe(Rectangle(width: 20, height: 20)) == "large"
  expect describe(Triangle(base: 2, height: 2)) == "small"
