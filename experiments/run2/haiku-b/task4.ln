type Account
  id: Text
  balance: Decimal

enum BankError
  InsufficientFunds

fn transfer(from_account: Account, to_account: Account, amount: Decimal) throws BankError -> (Account, Account)
  require amount > 0
  if amount > from_account.balance
    throw InsufficientFunds
  let new_from = from_account.with(balance: from_account.balance - amount)
  let new_to = to_account.with(balance: to_account.balance + amount)
  return (new_from, new_to)

test "transfer moves money"
  let account1 = Account(id: "1", balance: 100)
  let account2 = Account(id: "2", balance: 50)
  let (new_from, new_to) = try transfer(account1, account2, 30)
  expect new_from.balance == 70
  expect new_to.balance == 80

test "transfer fails on insufficient funds"
  let account1 = Account(id: "1", balance: 10)
  let account2 = Account(id: "2", balance: 50)
  let err = expect throws transfer(account1, account2, 30)
  expect err is InsufficientFunds

test "transfer fails on negative amount"
  let account1 = Account(id: "1", balance: 100)
  let account2 = Account(id: "2", balance: 50)
  try transfer(account1, account2, -10) catch err => none
  # If we reach here, the transfer was not rejected. This test
  # would need proper assertion that a require failed, which is
  # different from throws.

# Example call site showing error handling:
fn transfer_with_error_handling(from: Account, to: Account, amount: Decimal)
  try
    let (updated_from, updated_to) = try transfer(from, to, amount)
    print("Transfer successful")
  catch err
    match err
      case InsufficientFunds => print("Not enough money in account")
