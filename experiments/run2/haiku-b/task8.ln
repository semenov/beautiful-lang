resource Stack<T>
  var items: List<T> = []

fn push<T>(stack: Stack<T>, item: T)
  stack.items.append(item)

fn pop<T>(stack: Stack<T>) -> T?
  if stack.items.is_empty()
    return none
  return stack.items.pop()

fn peek<T>(stack: Stack<T>) -> T?
  return stack.items.last()

test "stack with integers"
  let stack: Stack<Int> = Stack()
  push(stack, 1)
  push(stack, 2)
  push(stack, 3)
  expect peek(stack) == 3
  expect pop(stack) == 3
  expect peek(stack) == 2
  expect pop(stack) == 2
  expect pop(stack) == 1
  expect pop(stack) == none

test "stack is empty"
  let stack: Stack<Int> = Stack()
  expect pop(stack) == none
  expect peek(stack) == none

test "stack with text"
  let stack: Stack<Text> = Stack()
  push(stack, "hello")
  push(stack, "world")
  expect pop(stack) == "world"
  expect pop(stack) == "hello"
  expect pop(stack) == none
