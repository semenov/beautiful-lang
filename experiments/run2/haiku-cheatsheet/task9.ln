interface Storage
  fn get(key: Text) -> Text?
  fn put(key: Text, value: Text)
  fn delete(key: Text)

interface Listable
  fn keys() -> List<Text>

resource MemoryStorage
  var data: Map<Text, Text> = {}

fn get(storage: MemoryStorage, key: Text) -> Text?
  return storage.data[key]

fn put(storage: MemoryStorage, key: Text, value: Text)
  storage.data[key] = value

fn delete(storage: MemoryStorage, key: Text)
  storage.data.remove(key)

fn keys(storage: MemoryStorage) -> List<Text>
  return storage.data.keys()

resource FileStorage
  var directory: Text

fn get(storage: FileStorage, key: Text) -> Text? throws
  let path = "{storage.directory}/{key}"
  return try files.read(path) catch none

fn put(storage: FileStorage, key: Text, value: Text) throws
  let path = "{storage.directory}/{key}"
  try files.write(path, value)

fn delete(storage: FileStorage, key: Text) throws
  let path = "{storage.directory}/{key}"
  try files.delete(path)

fn keys(storage: FileStorage) -> List<Text> throws
  return try files.list(storage.directory)

fn copy_with_prefix<S: Storage + Listable>(from: S, to: S, prefix: Text)
  for key in from.keys()
    if key.starts_with(prefix)
      if from.get(key) is some(value)
        to.put(key, value: value)

test "memory_storage_basic"
  let storage = MemoryStorage()
  storage.put(key: "name", value: "Alice")
  storage.put(key: "age", value: "30")

  expect storage.get("name") == some("Alice")
  expect storage.get("age") == some("30")
  expect storage.get("missing") == none

test "copy_with_prefix"
  let storage1 = MemoryStorage()
  let storage2 = MemoryStorage()

  storage1.put(key: "user:1", value: "Alice")
  storage1.put(key: "user:2", value: "Bob")
  storage1.put(key: "config:x", value: "10")

  copy_with_prefix(from: storage1, to: storage2, prefix: "user:")

  expect storage2.get("user:1") == some("Alice")
  expect storage2.get("user:2") == some("Bob")
  expect storage2.get("config:x") == none
