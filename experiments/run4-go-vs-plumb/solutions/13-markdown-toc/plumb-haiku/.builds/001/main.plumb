import cli
import files
import process
import regex

type Options {
  min_level: Int = 1
  max_level: Int = 6
  file: String? = none
}

type Heading {
  level: Int
  text: String
  slug: String
}

fn main() throws {
  let opts = try parse_options()
  let content = try read_input(opts.file)
  let headings = parse_headings(content, min_level: opts.min_level, max_level: opts.max_level)

  if headings.is_empty() {
    return
  }

  for heading in headings {
    let indent = " ".repeat((heading.level - opts.min_level) * 2)
    print("${indent}- [${heading.text}](#${heading.slug})")
  }
}

fn parse_options() throws -> Options {
  let args = process.args()

  var min_level = 1
  var max_level = 6
  var file: String? = none
  var i = 1

  while i < args.length {
    let arg = args[i]

    if arg == "--min-level" {
      i += 1
      if i >= args.length {
        throw usage("--min-level requires a value")
      }
      min_level = try args[i].to_int() catch err {
        throw usage("invalid min-level value")
      }
    } else if arg == "--max-level" {
      i += 1
      if i >= args.length {
        throw usage("--max-level requires a value")
      }
      max_level = try args[i].to_int() catch err {
        throw usage("invalid max-level value")
      }
    } else if arg.starts_with("--") {
      throw usage("unknown option: ${arg}")
    } else if file is none {
      file = arg
    } else {
      throw usage("multiple files not allowed")
    }

    i += 1
  }

  if min_level < 1 or min_level > 6 {
    throw usage("min-level must be between 1 and 6")
  }
  if max_level < 1 or max_level > 6 {
    throw usage("max-level must be between 1 and 6")
  }
  if min_level > max_level {
    throw usage("min-level must not be greater than max-level")
  }

  return Options(min_level: min_level, max_level: max_level, file: file)
}

fn read_input(file: String?) throws -> String {
  if file is some(path) {
    return try files.read(path) catch err {
      eprint("error: cannot read ${path}")
      process.exit(2)
    }
  }

  var result = ""
  with stdin = io.stdin() {
    while let chunk = try stdin.read_text() {
      result.append_text(chunk)
    }
  }
  return result
}

fn parse_headings(content: String, min_level: Int, max_level: Int) -> List<Heading> {
  let lines = content.split("\n")
  var headings: List<Heading> = []
  var slug_count: Map<String, Int> = {}
  var in_fence = false
  var fence_char: String? = none
  var fence_count = 0

  for line_raw in lines {
    // Trim trailing \r if present (Windows line endings)
    let line = if line_raw.ends_with("\r") {
      line_raw.substring(0, line_raw.length - 1)
    } else {
      line_raw
    }

    // Check for fence opening/closing
    let leading_spaces = count_leading_spaces(line)
    if leading_spaces <= 3 {
      let fence_info = check_fence_marker(line.substring(leading_spaces, line.length))
      if fence_info is some(info) {
        if in_fence {
          if info.char == fence_char and info.count >= fence_count {
            in_fence = false
            fence_char = none
          }
        } else {
          in_fence = true
          fence_char = info.char
          fence_count = info.count
        }
        continue
      }
    }

    // Skip lines inside fenced code blocks
    if in_fence {
      continue
    }

    // Check if this is a heading
    let heading_info = parse_heading_line(line)
    if heading_info is some(info) {
      let slug_base = text_to_slug(info.text)
      let slug = if slug_base.is_empty() {
        ""
      } else {
        let count = slug_count[slug_base] ?? 0
        slug_count[slug_base] = count + 1
        if count == 0 {
          slug_base
        } else {
          "${slug_base}-${count}"
        }
      }

      // Only add to output if it has non-empty text and is in the selected levels
      if not info.text.is_empty() and info.level >= min_level and info.level <= max_level {
        headings.append(Heading(level: info.level, text: info.text, slug: slug))
      }
    }
  }

  return headings
}

type FenceInfo {
  char: String
  count: Int
}

fn check_fence_marker(text: String) -> FenceInfo? {
  if text.length < 3 {
    return none
  }

  let first_char = text.substring(0, 1)
  if first_char != "`" and first_char != "~" {
    return none
  }

  var count = 0
  for i in 0..<text.length {
    let c = text.substring(i, i + 1)
    if c == first_char {
      count += 1
    } else if c != " " and c != "\t" {
      break
    }
  }

  if count >= 3 {
    return some(FenceInfo(char: first_char, count: count))
  }

  return none
}

type HeadingInfo {
  level: Int
  text: String
}

fn parse_heading_line(line: String) -> HeadingInfo? {
  let leading_spaces = count_leading_spaces(line)

  // Must have 0-3 leading spaces
  if leading_spaces > 3 {
    return none
  }

  let rest = line.substring(leading_spaces, line.length)

  // Count # characters at the start
  var hash_count = 0
  for i in 0..<rest.length {
    let c = rest.substring(i, i + 1)
    if c == "#" {
      hash_count += 1
    } else {
      break
    }
  }

  // Must have 1-6 # characters
  if hash_count == 0 or hash_count > 6 {
    return none
  }

  let after_hashes = rest.substring(hash_count, rest.length)

  // After the hashes, must be end of line or space/tab followed by text
  if after_hashes.is_empty() {
    // Empty heading (e.g., "###")
    return some(HeadingInfo(level: hash_count, text: ""))
  }

  let first_char = after_hashes.substring(0, 1)
  if first_char != " " and first_char != "\t" {
    // Not a heading (e.g., "#hashtag")
    return none
  }

  // Get the text after the space/tab
  let text_part = after_hashes.substring(1, after_hashes.length).trim()

  // Remove trailing # marks if they form a complete run at the end
  let final_text = strip_trailing_hashes(text_part)

  return some(HeadingInfo(level: hash_count, text: final_text))
}

fn strip_trailing_hashes(text: String) -> String {
  // Remove trailing spaces/tabs
  var trimmed = text.trim_end()

  // Check if it ends with # characters
  if trimmed.is_empty() {
    return ""
  }

  var hash_start = trimmed.length
  for i in (0..<trimmed.length).reversed() {
    let c = trimmed.substring(i, i + 1)
    if c == "#" {
      hash_start = i
    } else {
      break
    }
  }

  // If we found trailing hashes, check if they should be removed
  if hash_start < trimmed.length {
    let hash_run = trimmed.substring(hash_start, trimmed.length)
    if hash_start == 0 {
      // All hashes: return empty
      return ""
    }

    // Check if there's a space or tab before the hash run
    let before_hashes = trimmed.substring(hash_start - 1, hash_start)
    if before_hashes == " " or before_hashes == "\t" {
      // Remove the hashes and the space before them
      return trimmed.substring(0, hash_start - 1).trim_end()
    }
  }

  return trimmed
}

fn count_leading_spaces(text: String) -> Int {
  var count = 0
  for i in 0..<text.length {
    let c = text.substring(i, i + 1)
    if c == " " {
      count += 1
    } else if c == "\t" {
      count += 1
    } else {
      break
    }
  }
  return count
}

fn text_to_slug(text: String) -> String {
  // 1. Convert to lowercase
  let lower = text.to_lower()

  // 2. Keep only letters, combining marks, digits, spaces, -, _
  var slug_chars: List<String> = []
  for i in 0..<lower.length {
    let c = lower.substring(i, i + 1)
    if is_valid_slug_char(c) {
      slug_chars.append(c)
    }
  }

  // 3. Replace spaces with -
  var result = ""
  for c in slug_chars {
    if c == " " {
      result.append_text("-")
    } else {
      result.append_text(c)
    }
  }

  return result
}

fn is_valid_slug_char(c: String) -> Bool {
  // Allow: letters (L*), combining marks (M*), digits (Nd), space, -, _
  // For simplicity, we'll use ASCII ranges and common Unicode

  if c == " " or c == "-" or c == "_" {
    return true
  }

  let code = c.char_at(0)

  // ASCII letters (a-z already lowercased, A-Z)
  if code >= 97 and code <= 122 {  // a-z
    return true
  }

  // ASCII digits (0-9)
  if code >= 48 and code <= 57 {
    return true
  }

  // For Unicode letters and other categories, we need to handle them
  // This is a simplified check - we'll accept characters that are not ASCII punctuation
  // and not ASCII whitespace (except space which we handled above)

  // Check if it's a letter or digit by trying to parse and checking its properties
  if is_unicode_letter_or_digit(c) {
    return true
  }

  return false
}

fn is_unicode_letter_or_digit(c: String) -> Bool {
  // This is a simplified implementation
  // For full Unicode support, we'd need a proper Unicode database
  // For now, we accept non-ASCII characters that are likely letters

  let code = c.char_at(0)

  // Extended ASCII and common Unicode ranges
  if code >= 128 {
    // Latin Extended (À-ÿ and beyond)
    if code >= 192 and code <= 687 {  // Latin Extended-A and B
      return true
    }
    // Greek (Α-ω)
    if code >= 913 and code <= 969 {
      return true
    }
    // Cyrillic
    if code >= 1040 and code <= 1103 {
      return true
    }
    // Many other Unicode ranges could be added
    // For now, accept most non-ASCII characters as potential letters
    if code >= 256 {
      return true
    }
  }

  return false
}

type UsageError implements Error {
  message_text: String

  fn message(self) -> String {
    return self.message_text
  }
}

fn usage(msg: String) throws -> Never {
  eprint("usage: app [--min-level N] [--max-level M] [FILE]")
  process.exit(64)
}
