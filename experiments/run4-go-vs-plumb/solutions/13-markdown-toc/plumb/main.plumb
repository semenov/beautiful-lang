// markdown-toc: prints a table of contents for a Markdown document.

import files
import io
import process

let usage_text = "usage: app [--min-level N] [--max-level M] [FILE]"

// Start of each run of ten decimal digits (Unicode Nd).
let digit_starts: List<Int> = [
  0x30, 0x660, 0x6F0, 0x7C0, 0x966, 0x9E6, 0xA66, 0xAE6, 0xB66, 0xBE6, 0xC66, 0xCE6,
