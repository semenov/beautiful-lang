  [0xCE2, 0xCE3], [0xD00, 0xD03], [0xD3B, 0xD3C], [0xD3E, 0xD4D], [0xD57, 0xD57],
  [0xD62, 0xD63], [0xD82, 0xD83], [0xDCA, 0xDDF], [0xDF2, 0xDF3], [0xE31, 0xE31],
