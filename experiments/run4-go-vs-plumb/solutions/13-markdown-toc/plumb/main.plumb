  [0x1D17B, 0x1D182], [0x1D185, 0x1D18B], [0x1D1AA, 0x1D1AD], [0xE0100, 0xE01EF],
]

type Heading {
  level: Int
  text: String
  slug: String
}

type Options {
  min_level: Int
  max_level: Int
  file: String?
}

fn fail_usage() -> Never {
  eprint(usage_text)
  process.exit(64)
}

fn is_digit_or_mark(cp: Int) -> Bool {
  for start in digit_starts {
    let last = if start == 0x1D7CE { start + 49 } else { start + 9 }
    if cp >= start and cp <= last {
      return true
    }
  }
  for r in mark_ranges {
    if cp >= r[0] and cp <= r[1] {
      return true
    }
  }
  return false
}

// Simple lowercase mapping of one character.
fn lower_char(c: String) -> String {
  if c == "\u{130}" {
    return "i"
  }
  return c.lower()
}

fn keep_in_slug(c: String) -> Bool {
  if c == " " or c == "-" or c == "_" {
    return true
  }
  if c.is_letter() {
    return true
  }
  let cps = c.code_points()
  return is_digit_or_mark(cps[0])
}

fn base_slug(text: String) -> String {
  var out: List<String> = []
  for c in text.chars() {
    let l = lower_char(c)
    // lowering one character may give several; check each
    for k in l.chars() {
      if keep_in_slug(k) {
        out.append(if k == " " { "-" } else { k })
      }
    }
  }
  return out.join("")
}

fn is_blank(c: String) -> Bool {
  return c == " " or c == "\t"
}

fn trim_blanks_end(chars: List<String>) -> List<String> {
  var n = chars.length
  while n > 0 and is_blank(chars[n - 1]) {
    n -= 1
  }
  return chars.take(n)
}

// The heading text of a line, or none if the line is not a heading.
fn parse_heading(line: String) -> Heading? {
  let chars = line.chars()
  var i = 0
  while i < chars.length and chars[i] == " " {
    i += 1
  }
  if i > 3 {
    return none
  }
  var level = 0
  while i < chars.length and chars[i] == "#" {
    i += 1
    level += 1
  }
  if level < 1 or level > 6 {
    return none
  }
  if i < chars.length and not is_blank(chars[i]) {
    return none
  }
  var rest = chars.drop(i)
  var start = 0
  while start < rest.length and is_blank(rest[start]) {
    start += 1
  }
  rest = trim_blanks_end(rest.drop(start))
  var n = rest.length
  while n > 0 and rest[n - 1] == "#" {
    n -= 1
  }
  if n < rest.length and (n == 0 or is_blank(rest[n - 1])) {
    rest = trim_blanks_end(rest.take(n))
  }
  if rest.is_empty() {
    return none
  }
  let text = rest.join("")
  return Heading(level: level, text: text, slug: base_slug(text))
}

// If the line opens a fence: its character and length.
type Fence {
  char: String
  length: Int
}

fn fence_of(line: String) -> Fence? {
  let chars = line.chars()
  var i = 0
  while i < chars.length and chars[i] == " " {
    i += 1
  }
  if i > 3 or i >= chars.length {
    return none
  }
  let c = chars[i]
  if c != "`" and c != "~" {
    return none
  }
  var n = 0
  while i < chars.length and chars[i] == c {
    i += 1
    n += 1
  }
  if n < 3 {
    return none
  }
  return Fence(char: c, length: n)
}

fn closes_fence(line: String, fence: Fence) -> Bool {
  let chars = line.chars()
  var i = 0
  while i < chars.length and chars[i] == " " {
    i += 1
  }
  if i > 3 {
    return false
  }
  var n = 0
  while i < chars.length and chars[i] == fence.char {
    i += 1
    n += 1
  }
  if n < fence.length {
    return false
  }
  while i < chars.length {
    if not is_blank(chars[i]) {
      return false
    }
    i += 1
  }
  return true
}

// All headings with text, in order, with their final (numbered) slugs.
fn headings_of(input: String) -> List<Heading> {
  var result: List<Heading> = []
  var seen: Map<String, Int> = {}
  var open: Fence? = none
  for raw in input.split("\n") {
    let line = if raw.ends_with("\r") { raw.slice(from: 0, to: raw.length - 1) } else { raw }
    if open is some(f) {
      if closes_fence(line, f) {
        open = none
      }
      continue
    }
    if fence_of(line) is some(f) {
      open = f
      continue
    }
    if parse_heading(line) is some(h) {
      let count = seen[h.slug] ?? 0
      seen[h.slug] = count + 1
      let slug = if count == 0 { h.slug } else { "${h.slug}-${count}" }
      result.append(Heading(level: h.level, text: h.text, slug: slug))
    }
  }
  return result
}

fn render(input: String, min_level: Int, max_level: Int) -> List<String> {
  var lines: List<String> = []
  for h in headings_of(input) {
    if h.level >= min_level and h.level <= max_level {
      lines.append("${" ".repeat(2 * (h.level - min_level))}- [${h.text}](#${h.slug})")
    }
  }
  return lines
}

fn level_value(text: String) -> Int {
  let n = try text.to_int() catch _ {
    fail_usage()
  }
  if n < 1 or n > 6 {
    fail_usage()
  }
  return n
}

fn parse_args(args: List<String>) -> Options {
  var min_level = 1
  var max_level = 6
  var file: String? = none
  var files_only = false
  var i = 0
  while i < args.length {
    let a = args[i]
    i += 1
    if files_only or not a.starts_with("-") or a == "-" {
      if file is some(_) {
        fail_usage()
      }
      file = a
    } else if a == "--" {
      files_only = true
    } else if a == "--min-level" or a == "--max-level" {
      if i >= args.length {
        fail_usage()
      }
      let v = level_value(args[i])
      i += 1
      if a == "--min-level" {
        min_level = v
      } else {
        max_level = v
      }
    } else if a.starts_with("--min-level=") {
      min_level = level_value(a.slice(from: 12, to: a.length))
    } else if a.starts_with("--max-level=") {
      max_level = level_value(a.slice(from: 12, to: a.length))
    } else {
      fail_usage()
    }
  }
  if min_level > max_level {
    fail_usage()
  }
  return Options(min_level: min_level, max_level: max_level, file: file)
}

fn main() throws {
  let opts = parse_args(process.args())
  var input = ""
  if opts.file is some(path) {
    input = try files.read(path) catch _ {
      eprint("error: cannot read ${path}")
      process.exit(2)
    }
  } else {
    with stdin = io.stdin() {
      input = try stdin.read_all().text_lossy()
    }
  }
  for line in render(input, min_level: opts.min_level, max_level: opts.max_level) {
    print(line)
  }
}

test "example" {
  let doc = "# Größe & Maße\n## Setup\n#### Deep\n## Setup ##\n```\n# not a heading\n```\n### Step 1.2: run `make`\n"
  expect render(doc, min_level: 1, max_level: 3) == [
    "- [Größe & Maße](#größe--maße)",
    "  - [Setup](#setup)",
    "  - [Setup](#setup-1)",
    "    - [Step 1.2: run `make`](#step-12-run-make)",
  ]
}

test "heading text" {
  expect parse_heading("# C#")?.text == "C#"
  expect parse_heading("### ###") is none
  expect parse_heading("#hashtag") is none
  expect parse_heading("####### x") is none
  expect parse_heading("    # x") is none
  expect parse_heading("#") is none
  expect parse_heading("## Title ##  ")?.text == "Title"
  expect parse_heading("#\tTab\t#\t")?.text == "Tab"
}

test "slugs" {
  expect base_slug("A  B") == "a--b"
  expect base_slug("Caf\u{65}\u{301}!") == "cafe\u{301}"
  expect base_slug("\u{130}x") == "ix"
  expect base_slug("a_b-c\td") == "a_b-cd"
  expect base_slug("\u{663}") == "\u{663}"
}

test "fences" {
  let doc = "~~~~\n# a\n~~~\n# b\n~~~~~\n# c\n````\n# d"
  expect render(doc, min_level: 1, max_level: 6) == ["- [c](#c)"]
}
