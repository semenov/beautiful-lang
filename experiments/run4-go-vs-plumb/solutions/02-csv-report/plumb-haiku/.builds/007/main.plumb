import csv
import io
import files
import process

type ParseError implements Error {
  message_text: String

  fn message(self) -> String {
    return self.message_text
  }
}

type CharAt {
  char: String
  is_quote: Bool
  is_comma: Bool
  is_newline: Bool
  is_cr: Bool
}

type ParsedField {
  value: String
  end_pos: Int
}

type ParseRecord {
  fields: List<String>
  end_pos: Int
}

type ParseCSVResult {
  records: List<List<String>>
  line_count: Int
}

fn char_at(text: String, pos: Int) -> CharAt? {
  if pos >= text.length {
    return none
  }
  let slice = text.slice(from: pos, to: pos + 1)
  return CharAt(
    char: slice,
    is_quote: slice == "\"",
    is_comma: slice == ",",
    is_newline: slice == "\n",
    is_cr: slice == "\r"
  )
}

// Parse a CSV field starting at position pos in the text
// Returns the field value and the position after the field
fn parse_field(text: String, pos: Int) -> ParsedField? {
  if pos >= text.length {
    return none
  }

  if char_at(text, pos: pos) is some(c) {
    if c.is_quote {
      // Quoted field
      var field_chars: List<String> = []
      var i = pos + 1
      while i < text.length {
        if char_at(text, pos: i) is some(ch) {
          if ch.is_quote {
            // Found a quote - check if it's escaped or the end
            i += 1
            if i < text.length {
              if char_at(text, pos: i) is some(next) {
                if next.is_quote {
                  // Escaped quote: ""
                  field_chars.append("\"")
                  i += 1
                } else if next.is_comma or next.is_newline or next.is_cr {
                  // End of quoted field
                  return ParsedField(value: field_chars.join(""), end_pos: i)
                } else {
                  // Invalid: quote not followed by comma, newline, or another quote
                  return none
                }
              } else {
                // End of text after quote - end of field
                return ParsedField(value: field_chars.join(""), end_pos: i)
              }
            } else {
              // End of text - end of field
              return ParsedField(value: field_chars.join(""), end_pos: i)
            }
          } else {
            field_chars.append(ch.char)
            i += 1
          }
        } else {
          return none
        }
      }
      // Unterminated quote
      return none
    } else {
      // Unquoted field
      var field_chars: List<String> = []
      var i = pos
      while i < text.length {
        if char_at(text, pos: i) is some(ch) {
          if ch.is_comma or ch.is_newline or ch.is_cr {
            return ParsedField(value: field_chars.join(""), end_pos: i)
          } else {
            field_chars.append(ch.char)
            i += 1
          }
        } else {
          return ParsedField(value: field_chars.join(""), end_pos: i)
        }
      }
      // End of text
      return ParsedField(value: field_chars.join(""), end_pos: i)
    }
  }
  return none
}

// Parse a single CSV record starting at position pos
// Returns the fields and the position after the record
fn parse_record(text: String, pos: Int) -> ParseRecord? {
  var fields: List<String> = []
  var i = pos

  while i < text.length {
    if parse_field(text, pos: i) is some(field_result) {
      fields.append(field_result.value)
      i = field_result.end_pos

      if i >= text.length {
        break
      }

      if char_at(text, pos: i) is some(c) {
        if c.is_comma {
          i += 1
        } else if c.is_cr {
          i += 1
          if i < text.length {
            if char_at(text, pos: i) is some(next) {
              if next.is_newline {
                i += 1
              }
            }
          }
          break
        } else if c.is_newline {
          i += 1
          break
        }
      }
    } else {
      return none
    }
  }

  return ParseRecord(fields: fields, end_pos: i)
}

fn parse_csv(text: String) throws -> ParseCSVResult {
  var records: List<List<String>> = []
  var pos = 0
  var line = 1

  while pos < text.length {
    // Skip empty lines
    if char_at(text, pos: pos) is some(c) {
      if c.is_newline {
        line += 1
        pos += 1
        continue
      }
      if c.is_cr {
        if pos + 1 < text.length {
          if char_at(text, pos: pos + 1) is some(next) {
            if next.is_newline {
              line += 1
              pos += 2
            } else {
              line += 1
              pos += 1
            }
          } else {
            line += 1
            pos += 1
          }
        } else {
          line += 1
          pos += 1
        }
        continue
      }
    }

    if parse_record(text, pos: pos) is some(record_result) {
      if record_result.fields.length > 0 {
        records.append(record_result.fields)
      }
      pos = record_result.end_pos
      line += 1
    } else {
      throw ParseError(message_text: "line ${line}: unterminated quote")
    }
  }

  return ParseCSVResult(records: records, line_count: line)
}

fn is_digit(c: String) -> Bool {
  return c >= "0" and c <= "9"
}

fn parse_amount(text: String) -> Decimal? {
  let trimmed = text.trim()
  if trimmed.is_empty() {
    return none
  }

  // Check format: optional minus, digits, optional dot and 1-2 digits
  var i = 0
  if trimmed.starts_with("-") {
    i += 1
  }

  if i >= trimmed.length {
    return none
  }

  let char_after_minus = trimmed.slice(from: i, to: i + 1)
  if not is_digit(char_after_minus) {
    return none
  }

  // Read digits before decimal
  while i < trimmed.length and is_digit(trimmed.slice(from: i, to: i + 1)) {
    i += 1
  }

  // Check for decimal point
  if i < trimmed.length and trimmed.slice(from: i, to: i + 1) == "." {
    i += 1
    if i >= trimmed.length or not is_digit(trimmed.slice(from: i, to: i + 1)) {
      return none
    }

    let decimal_start = i
    while i < trimmed.length and is_digit(trimmed.slice(from: i, to: i + 1)) {
      i += 1
    }

    let decimal_digits = i - decimal_start
    if decimal_digits > 2 {
      return none
    }
  }

  // Must be at end of string
  if i != trimmed.length {
    return none
  }

  // Parse using Decimal
  let value = try trimmed.to_decimal() catch err {
    return none
  }
  return value
}

fn format_amount(amount: Decimal) -> String {
  if amount == 0 {
    return "0.00"
  }
  return amount.format(places: 2)
}

fn quote_csv_field(field: String) -> String {
  if field.contains(",") or field.contains("\"") or field.contains("\n") or field.contains("\r") {
    let quoted = field.replace("\"", new: "\"\"")
    return "\"${quoted}\""
  }
  return field
}

fn main() throws {
  let args = process.args()

  // Parse command-line arguments
  var by_column: String? = none
  var file: String? = none
  var i = 0

  while i < args.length {
    let arg = args[i]
    if arg == "--by" {
      i += 1
      if i >= args.length {
        eprint("usage: app --by COLUMN [FILE]")
        process.exit(64)
      }
      by_column = args[i]
      i += 1
    } else if arg.starts_with("--") {
      eprint("usage: app --by COLUMN [FILE]")
      process.exit(64)
    } else {
      if file is some(_) {
        eprint("usage: app --by COLUMN [FILE]")
        process.exit(64)
      }
      file = arg
      i += 1
    }
  }

  let group_by = match by_column {
    some(col) => col
    none => {
      eprint("usage: app --by COLUMN [FILE]")
      process.exit(64)
    }
  }

  // Read input
  let input_text = if file is some(f) {
    try files.read(f) catch err {
      eprint("error: cannot read ${f}")
      process.exit(2)
    }
  } else {
    // Read from stdin
    try io.read_all().text()
  }

  if input_text.is_empty() {
    eprint("error: empty input")
    process.exit(2)
  }

  // Parse CSV
  let parse_result = try parse_csv(input_text)
  let records = parse_result.records

  if records.length == 0 {
    eprint("error: empty input")
    process.exit(2)
  }

  let header = records[0]

  // Find column indices
  var amount_index: Int? = none
  var group_index: Int? = none

  for item in header.indexed() {
    if item.value == "amount" {
      amount_index = item.index
    }
    if item.value == group_by {
      group_index = item.index
    }
  }

  let amount_col = match amount_index {
    some(idx) => idx
    none => {
      eprint("error: missing column amount")
      process.exit(2)
    }
  }

  let group_col = match group_index {
    some(idx) => idx
    none => {
      eprint("error: missing column ${group_by}")
      process.exit(2)
    }
  }

  // Group and sum amounts
  var groups: Map<String, Decimal> = {}
  var has_bad_record = false

  for rec_index in 1..<records.length {
    let record = records[rec_index]

    // Check field count
    if record.length != header.length {
      eprint("line ${rec_index + 1}: wrong number of fields")
      has_bad_record = true
      continue
    }

    // Parse amount
    if parse_amount(record[amount_col]) is some(amount) {
      let group_value = record[group_col]
      let current = groups[group_value] ?? 0
      groups[group_value] = current + amount
    } else {
      eprint("line ${rec_index + 1}: invalid amount")
      has_bad_record = true
    }
  }

  // Sort and output
  var output: List<List<String>> = []
  output.append([group_by, "total"])

  let sorted_groups = groups.entries().sorted_by(e => e.key)
  for entry in sorted_groups {
    output.append([entry.key, format_amount(entry.value)])
  }

  print(csv.encode(output))

  if has_bad_record {
    process.exit(1)
  }
}
