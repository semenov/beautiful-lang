import io
import files
import process

let usage_text = "usage: app --by COLUMN [FILE]"

// One record of the input: where it starts, its fields, and why it is bad
// ("" if the record is fine).
type Rec {
  line: Int
  fields: List<String>
  error: String
}

type Options {
  by: String
  file: String?
}

fn usage_exit() -> Never {
  eprint(usage_text)
  process.exit(64)
}

fn parse_args(args: List<String>) -> Options {
  var by: String? = none
  var file: String? = none
  var i = 0
  while i < args.length {
    let a = args[i]
    if a == "--by" {
      if i + 1 >= args.length {
        usage_exit()
      }
      by = args[i + 1]
      i += 2
    } else if a.length > 1 and a.starts_with("-") {
      usage_exit()
    } else {
      if file is some(_) {
        usage_exit()
      }
      file = a
      i += 1
    }
  }
  if by is none {
    usage_exit()
  }
  return Options(by: by, file: file)
}

// Splits the text into records (RFC 4180, with the spec's rules for bad
// records). Empty lines are skipped.
fn parse_records(cs: List<String>) -> List<Rec> {
  var recs: List<Rec> = []
  let n = cs.length
  var i = 0
  var line = 1
  while i < n {
    if cs[i] == "\n" {
      i += 1
      line += 1
      continue
    }
    if cs[i] == "\r" and i + 1 < n and cs[i + 1] == "\n" {
      i += 2
      line += 1
      continue
    }
    let start = line
    var fields: List<String> = []
    var err = ""
    while true {
      var buf: List<String> = []
      if i < n and cs[i] == "\"" {
        i += 1
        var closed = false
        while i < n and not closed {
          let c = cs[i]
          if c == "\"" {
            if i + 1 < n and cs[i + 1] == "\"" {
              buf.append("\"")
              i += 2
            } else {
              closed = true
              i += 1
            }
          } else {
            if c == "\n" {
              line += 1
            }
            buf.append(c)
            i += 1
          }
        }
        if not closed {
          err = "unterminated quote"
          i = n
          break
        }
        fields.append(buf.join(""))
        if i >= n {
          break
        }
        if cs[i] == "," {
          i += 1
          continue
        }
        if cs[i] == "\n" {
          i += 1
          line += 1
          break
        }
        if cs[i] == "\r" and i + 1 < n and cs[i + 1] == "\n" {
          i += 2
          line += 1
          break
        }
        err = "unexpected character after closing quote"
        while i < n and cs[i] != "\n" {
          i += 1
        }
        if i < n {
          i += 1
          line += 1
        }
        break
      } else {
        while i < n {
          let c = cs[i]
          if c == "," or c == "\n" or (c == "\r" and i + 1 < n and cs[i + 1] == "\n") {
            break
          }
          buf.append(c)
          i += 1
        }
        fields.append(buf.join(""))
        if i >= n {
          break
        }
        if cs[i] == "," {
          i += 1
          continue
        }
        if cs[i] == "\r" {
          i += 2
        } else {
          i += 1
        }
        line += 1
        break
      }
    }
    recs.append(Rec(line: start, fields: fields, error: err))
  }
  return recs
}

// The amount in cents, or none if it isn't a valid amount.
fn parse_cents(raw: String) -> Int? {
  let cs = raw.trim_chars(" ").chars()
  var i = 0
  var negative = false
  if cs.length > 0 and cs[0] == "-" {
    negative = true
    i = 1
  }
  var whole = 0
  var digits = 0
  while i < cs.length and is_ascii_digit(cs[i]) {
    whole = whole * 10 + digit_value(cs[i])
    digits += 1
    i += 1
  }
  if digits == 0 {
    return none
  }
  var frac = 0
  if i < cs.length {
    if cs[i] != "." {
      return none
    }
    i += 1
    let fd = cs.length - i
    if fd < 1 or fd > 2 {
      return none
    }
    var k = i
    while k < cs.length {
      if not is_ascii_digit(cs[k]) {
        return none
      }
      k += 1
    }
    frac = digit_value(cs[i])
    if fd == 2 {
      frac = frac * 10 + digit_value(cs[i + 1])
    } else {
      frac = frac * 10
    }
  }
  let cents = whole * 100 + frac
  if negative {
    return 0 - cents
  }
  return cents
}

fn is_ascii_digit(c: String) -> Bool {
  return c.length == 1 and c.code_points()[0] >= 48 and c.code_points()[0] <= 57
}

fn digit_value(c: String) -> Int {
  return c.code_points()[0] - 48
}

fn format_cents(cents: Int) -> String {
  let sign = if cents < 0 { "-" } else { "" }
  let abs = if cents < 0 { 0 - cents } else { cents }
  let frac = (abs % 100).to_string().pad_start(2, fill: "0")
  return "${sign}${abs.div(100)}.${frac}"
}

fn quote_field(s: String) -> String {
  if s.contains(",") or s.contains("\"") or s.contains("\r") or s.contains("\n") {
    return "\"${s.replace("\"", new: "\"\"")}\""
  }
  return s
}

fn index_of_name(names: List<String>, name: String) -> Int? {
  for item in names.indexed() {
    if item.value == name {
      return item.index
    }
  }
  return none
}

fn fail(message: String) -> Never {
  eprint("error: ${message}")
  process.exit(2)
}

fn main() throws {
  let opts = parse_args(process.args())
  var text = ""
  if opts.file is some(path) {
    text = try files.read(path) catch err {
      fail("cannot read ${path}")
    }
  } else {
    text = try io.read_all().text_lossy()
  }
  let recs = parse_records(text.chars())
  if recs.is_empty() {
    fail("empty input")
  }
  let header = recs[0].fields
  let amount_col = index_of_name(header, name: "amount") ?? fail("missing column amount")
  let by_col = index_of_name(header, name: opts.by) ?? fail("missing column ${opts.by}")

  var totals: Map<String, Int> = {}
  var any_bad = false
  for rec in recs.drop(1) {
    var reason = rec.error
    var cents = 0
    if reason == "" {
      if rec.fields.length != header.length {
        reason = "expected ${header.length} fields, got ${rec.fields.length}"
      } else if parse_cents(rec.fields[amount_col]) is some(c) {
        cents = c
      } else {
        reason = "invalid amount"
      }
    }
    if reason != "" {
      any_bad = true
      eprint("line ${rec.line}: ${reason}")
      continue
    }
    let key = rec.fields[by_col]
    totals[key] = (totals[key] ?? 0) + cents
  }

  var lines = ["${quote_field(opts.by)},total"]
  for e in totals.entries().sorted_by(e => e.key.code_points()) {
    lines.append("${quote_field(e.key)},${format_cents(e.value)}")
  }
  io.write("${lines.join("\n")}\n")
  if any_bad {
    process.exit(1)
  }
}

test "format" {
  expect format_cents(0) == "0.00"
  expect format_cents(-50) == "-0.50"
  expect format_cents(1060) == "10.60"
  expect format_cents(-1234) == "-12.34"
}

test "amounts" {
  expect parse_cents("12") == 1200
  expect parse_cents(" -0.5 ") == -50
  expect parse_cents("3.25") == 325
  expect parse_cents("+1") == none
  expect parse_cents(".5") == none
  expect parse_cents("5.") == none
  expect parse_cents("1.234") == none
  expect parse_cents("1e3") == none
  expect parse_cents("") == none
  expect parse_cents("-") == none
}
