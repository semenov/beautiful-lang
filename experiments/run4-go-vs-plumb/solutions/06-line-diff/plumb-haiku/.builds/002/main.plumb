import files
import process

type Change {
  kind: String
  line: String
  line_num_old: Int
  line_num_new: Int
}

type Hunk {
  old_start: Int
  old_count: Int
  new_start: Int
  new_count: Int
  changes: List<Change>
}

fn split_lines(text: String) -> List<String> {
  var lines: List<String> = []
  var current = ""
  for char in text.chars() {
    current += char
    if char == "\n" {
      lines.append(current)
      current = ""
    }
  }
  if not current.is_empty() {
    lines.append(current)
  }
  return lines
}

fn compute_lcs_table(old_lines: List<String>, new_lines: List<String>) -> Map<String, Int> {
  var memo: Map<String, Int> = {}

  fn lcs_helper(i: Int, j: Int) -> Int {
    if i >= old_lines.count() or j >= new_lines.count() {
      return 0
    }
    let key = "${i},${j}"
    if memo[key] is some(val) {
      return val
    }

    var result = 0
    if old_lines[i] == new_lines[j] {
      result = 1 + lcs_helper(i: i + 1, j: j + 1)
    } else {
      let left = lcs_helper(i: i + 1, j: j)
      let right = lcs_helper(i: i, j: j + 1)
      result = if left >= right { left } else { right }
    }
    memo[key] = result
    return result
  }

  let _ = lcs_helper(i: 0, j: 0)
  return memo
}

fn compute_changes(old_lines: List<String>, new_lines: List<String>, memo: Map<String, Int>) -> List<Change> {
  var changes: List<Change> = []
  var i = 0
  var j = 0
  var old_line_num = 1
  var new_line_num = 1

  while i < old_lines.count() or j < new_lines.count() {
    let old_done = i >= old_lines.count()
    let new_done = j >= new_lines.count()

    if not old_done and not new_done and old_lines[i] == new_lines[j] {
      changes.append(Change(kind: "keep", line: old_lines[i], line_num_old: old_line_num, line_num_new: new_line_num))
      i += 1
      j += 1
      old_line_num += 1
      new_line_num += 1
    } else if new_done or (not old_done and get_lcs(memo, i: i + 1, j: j) >= get_lcs(memo, i: i, j: j + 1)) {
      changes.append(Change(kind: "remove", line: old_lines[i], line_num_old: old_line_num, line_num_new: 0))
      i += 1
      old_line_num += 1
    } else {
      changes.append(Change(kind: "add", line: new_lines[j], line_num_old: 0, line_num_new: new_line_num))
      j += 1
      new_line_num += 1
    }
  }

  return changes
}

fn get_lcs(memo: Map<String, Int>, i: Int, j: Int) -> Int {
  let key = "${i},${j}"
  return memo[key] ?? 0
}

fn group_into_hunks(changes: List<Change>, context: Int) -> List<Hunk> {
  var hunks: List<Hunk> = []
  var i = 0

  while i < changes.count() {
    let change = changes[i]

    if change.kind != "keep" {
      // Start of a change - collect context before
      var hunk_start = if i >= context { i - context } else { 0 }
      var hunk_changes: List<Change> = []
      var idx = hunk_start
      while idx < i {
        hunk_changes.append(changes[idx])
        idx += 1
      }
      hunk_changes.append(change)

      i += 1
      var kept_after = 0

      // Collect changes and context after
      while i < changes.count() {
        let c = changes[i]
        if c.kind == "keep" {
          kept_after += 1
          hunk_changes.append(c)
          if kept_after > context {
            // Remove the oldest kept line
            var removed = 0
            var idx2 = 0
            while removed < 1 and idx2 < hunk_changes.count() {
              if hunk_changes[idx2].kind == "keep" {
                var new_changes: List<Change> = []
                var idx3 = 0
                while idx3 < hunk_changes.count() {
                  if idx3 != idx2 {
                    new_changes.append(hunk_changes[idx3])
                  }
                  idx3 += 1
                }
                hunk_changes = new_changes
                removed += 1
                kept_after -= 1
              } else {
                idx2 += 1
              }
            }
          }
          i += 1
        } else {
          kept_after = 0
          hunk_changes.append(c)
          i += 1
        }
      }

      // Create the hunk
      var old_start = 0
      var old_count = 0
      var new_start = 0
      var new_count = 0

      for c in hunk_changes {
        if c.line_num_old > 0 {
          if old_start == 0 {
            old_start = c.line_num_old
          }
          old_count += 1
        }
        if c.line_num_new > 0 {
          if new_start == 0 {
            new_start = c.line_num_new
          }
          new_count += 1
        }
      }

      if old_count == 0 {
        old_start = if hunk_changes.count() > 0 and hunk_changes[0].line_num_old > 0 { hunk_changes[0].line_num_old } else { 0 }
      }
      if new_count == 0 {
        new_start = if hunk_changes.count() > 0 and hunk_changes[0].line_num_new > 0 { hunk_changes[0].line_num_new } else { 0 }
      }

      hunks.append(Hunk(old_start: old_start, old_count: old_count, new_start: new_start, new_count: new_count, changes: hunk_changes))
    } else {
      i += 1
    }
  }

  return hunks
}

fn format_hunk_header(hunk: Hunk) -> String {
  let old_str = if hunk.old_count == 1 { "${hunk.old_start}" } else { "${hunk.old_start},${hunk.old_count}" }
  let new_str = if hunk.new_count == 1 { "${hunk.new_start}" } else { "${hunk.new_start},${hunk.new_count}" }
  return "@@ -${old_str} +${new_str} @@"
}

fn main() throws {
  let args = process.args()

  var context = 3
  var file_idx = 1

  if args.count() > 1 and args[1] == "-U" {
    if args.count() < 4 {
      eprint("usage: app [-U N] OLD NEW")
      process.exit(2)
    }
    let n_str = args[2]
    let n = try n_str.to_int() catch _ {
      eprint("usage: app [-U N] OLD NEW")
      process.exit(2)
    }
    if n < 0 {
      eprint("usage: app [-U N] OLD NEW")
      process.exit(2)
    }
    context = n
    file_idx = 3
  }

  if args.count() < file_idx + 2 {
    eprint("usage: app [-U N] OLD NEW")
    process.exit(2)
  }

  let old_file = args[file_idx]
  let new_file = args[file_idx + 1]

  if args.count() > file_idx + 2 {
    eprint("usage: app [-U N] OLD NEW")
    process.exit(2)
  }

  let old_text = try files.read(old_file) catch _ {
    eprint("error: cannot read ${old_file}")
    process.exit(2)
  }

  let new_text = try files.read(new_file) catch _ {
    eprint("error: cannot read ${new_file}")
    process.exit(2)
  }

  let old_lines = split_lines(text: old_text)
  let new_lines = split_lines(text: new_text)

  let memo = compute_lcs_table(old_lines: old_lines, new_lines: new_lines)
  let changes = compute_changes(old_lines: old_lines, new_lines: new_lines, memo: memo)

  var has_changes = false
  for change in changes {
    if change.kind != "keep" {
      has_changes = true
      break
    }
  }

  if not has_changes {
    process.exit(0)
  }

  print("--- ${old_file}")
  print("+++ ${new_file}")

  let hunks = group_into_hunks(changes: changes, context: context)

  for hunk in hunks {
    print(format_hunk_header(hunk: hunk))
    for change in hunk.changes {
      match change.kind {
        "keep" => print(" ${change.line}")
        "remove" => print("-${change.line}")
        "add" => print("+${change.line}")
        _ => { }
      }
    }
  }

  process.exit(1)
}
