import cli
import io
import files
import process

type Options {
  min_count: Int = 1
  files: List<String> = []
}

type LogEntry {
  endpoint: String
  status: Int
  latency: Int
}

type EndpointStats {
  endpoint: String
  count: Int
  error_count: Int
  latencies: List<Int>
}

type ProcessResult {
  valid: Int
  malformed: Int
  stats: Map<String, EndpointStats>
}

fn main() throws {
  let opts = try cli.decode<Options>()

  if opts.min_count < 1 {
    eprint("usage: app [--min-count N] [FILE...]")
    process.exit(64)
  }

  var total_valid = 0
  var total_malformed = 0
  var all_stats: Map<String, EndpointStats> = {}

  if opts.files.is_empty() {
    let result = try read_and_process_stream(io.stdin(), all_stats)
    total_valid = result.valid
    total_malformed = result.malformed
    all_stats = result.stats
  } else {
    for file_path in opts.files {
      if not files.exists(file_path) {
        eprint("error: cannot read ${file_path}")
        process.exit(2)
      }

      with f = try files.open(file_path) {
        let result = try read_and_process_stream(f, all_stats)
        total_valid += result.valid
        total_malformed += result.malformed
        all_stats = merge_stats(all_stats, result.stats)
      }
    }
  }

  let entries = all_stats.entries()
  let sorted = entries.sorted_by(e => [-e.value.count, e.value.endpoint])

  for entry in sorted {
    let stat = entry.value
    if stat.count >= opts.min_count {
      let error_rate = calculate_error_rate(stat.error_count, stat.count)
      let p50 = calculate_percentile(stat.latencies, 50)
      let p95 = calculate_percentile(stat.latencies, 95)
      let max_latency = stat.latencies.max() ?? 0

      print("${stat.endpoint} count=${stat.count} error_rate=${error_rate}% p50=${p50} p95=${p95} max=${max_latency}")
    }
  }

  print("total=${total_valid} malformed=${total_malformed}")
}

fn merge_stats(existing: Map<String, EndpointStats>, new: Map<String, EndpointStats>) -> Map<String, EndpointStats> {
  var result = existing

  for entry in new.entries() {
    let key = entry.key
    let new_stat = entry.value

    if result.contains_key(key) {
      let existing_stat = result[key]
      existing_stat.count += new_stat.count
      existing_stat.error_count += new_stat.error_count
      existing_stat.latencies.append_all(new_stat.latencies)
    } else {
      result[key] = new_stat
    }
  }

  return result
}

fn read_and_process_stream(stream: io.Stream, initial_stats: Map<String, EndpointStats>) throws -> ProcessResult {
  var valid = 0
  var malformed = 0
  var stats = initial_stats

  while try stream.read_line() is some(line) {
    if line.is_empty() {
      continue
    }

    if try parse_log_line(line) is some(entry) {
      valid += 1

      if stats.contains_key(entry.endpoint) {
        let stat = stats[entry.endpoint]
        stat.count += 1
        if entry.status >= 500 and entry.status <= 599 {
          stat.error_count += 1
        }
        stat.latencies.append(entry.latency)
      } else {
        var error_count = 0
        if entry.status >= 500 and entry.status <= 599 {
          error_count = 1
        }
        stats[entry.endpoint] = EndpointStats(
          endpoint: entry.endpoint,
          count: 1,
          error_count: error_count,
          latencies: [entry.latency]
        )
      }
    } else {
      malformed += 1
    }
  }

  return ProcessResult(valid: valid, malformed: malformed, stats: stats)
}

fn parse_log_line(line: String) -> LogEntry? {
  let parts = line.split(" ")

  if parts.length < 10 {
    return none
  }

  var quote_start = -1
  for i in 0..<parts.length {
    if parts[i].starts_with("\"") {
      quote_start = i
      break
    }
  }

  if quote_start == -1 or quote_start < 3 {
    return none
  }

  var quote_end = -1
  for i in quote_start..<parts.length {
    if parts[i].ends_with("\"") {
      quote_end = i
      break
    }
  }

  if quote_end == -1 {
    return none
  }

  let request_part = parts[quote_start].trim_chars("\"")
  let method_parts = request_part.split(" ")

  if method_parts.length < 3 {
    return none
  }

  let method = method_parts[0]
  let full_target = method_parts[1]

  if not is_valid_method(method) {
    return none
  }

  let target = extract_target(full_target)
  if target.is_empty() {
    return none
  }

  let endpoint = "${method} ${target}"

  let status_idx = quote_end + 1
  let latency_idx = quote_end + 3

  if status_idx >= parts.length or latency_idx >= parts.length {
    return none
  }

  let status = try parts[status_idx].to_int() catch {
    return none
  }

  if status < 100 or status > 599 {
    return none
  }

  let latency = try parts[latency_idx].to_int() catch {
    return none
  }

  return LogEntry(endpoint: endpoint, status: status, latency: latency)
}

fn is_valid_method(method: String) -> Bool {
  if method.is_empty() {
    return false
  }

  for c in method.chars() {
    let code_points = c.code_points()
    if code_points.is_empty() {
      return false
    }
    let cp = code_points[0]
    if cp < 65 or cp > 90 {
      return false
    }
  }

  return true
}

fn extract_target(target: String) -> String {
  if target.is_empty() {
    return ""
  }

  let qpos = target.index_of("?")
  if qpos is some(pos) {
    return target.slice(0, pos)
  }

  return target
}

fn calculate_error_rate(errors: Int, total: Int) -> String {
  if total == 0 {
    return "0.00"
  }

  let rate = errors.to_float() * 100.0 / total.to_float()
  return rate.format(2)
}

fn calculate_percentile(latencies: List<Int>, percentile: Int) -> Int {
  if latencies.is_empty() {
    return 0
  }

  let sorted = latencies.sorted()
  let n = sorted.length

  let pos = (percentile * n + 99) / 100
  let idx = pos - 1

  if idx >= n {
    return sorted[n - 1]
  }

  if idx < 0 {
    return sorted[0]
  }

  return sorted[idx]
}
