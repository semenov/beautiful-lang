import cli
import io
import files
import process
import regex

type Options {
  min_count: Int = 1
  files: List<String> = []
}

type LogEntry {
  endpoint: String
  status: Int
  latency: Int
}

type EndpointStats {
  endpoint: String
  count: Int
  error_count: Int
  latencies: List<Int>
}

fn main() throws {
  let opts = try cli.decode<Options>()

  if opts.min_count < 1 {
    eprint("usage: app [--min-count N] [FILE...]")
    process.exit(64)
  }

  var total_valid = 0
  var total_malformed = 0
  var stats: Map<String, EndpointStats> = {}

  // Read from files or stdin
  if opts.files.is_empty() {
    try read_and_process_stream(io.stdin(), opts.min_count, stats, mut total_valid, mut total_malformed)
  } else {
    for file_path in opts.files {
      if not files.exists(file_path) {
        eprint("error: cannot read ${file_path}")
        process.exit(2)
      }

      with f = try files.open(file_path) {
        try read_and_process_stream(f, opts.min_count, stats, mut total_valid, mut total_malformed)
      }
    }
  }

  // Sort and output results
  let entries = stats.entries()
  let sorted = entries
    .sorted_by(e => [-e.value.count, e.value.endpoint])

  for entry in sorted {
    let stat = entry.value
    if stat.count >= opts.min_count {
      let error_rate = calculate_error_rate(stat.error_count, stat.count)
      let p50 = calculate_percentile(stat.latencies, 50)
      let p95 = calculate_percentile(stat.latencies, 95)
      let max_latency = stat.latencies.max() ?? 0

      print("${stat.endpoint} count=${stat.count} error_rate=${error_rate}% p50=${p50} p95=${p95} max=${max_latency}")
    }
  }

  print("total=${total_valid} malformed=${total_malformed}")
}

fn read_and_process_stream(stream: io.Stream, min_count: Int, stats: mut Map<String, EndpointStats>, total_valid: mut Int, total_malformed: mut Int) throws {
  while try stream.read_line() is some(line) {
    if line.is_empty() {
      continue
    }

    if try parse_log_line(line) is some(entry) {
      total_valid += 1

      if stats.contains_key(entry.endpoint) {
        let s = stats[entry.endpoint]
        s.count += 1
        if entry.status >= 500 and entry.status <= 599 {
          s.error_count += 1
        }
        s.latencies.append(entry.latency)
      } else {
        var error_count = 0
        if entry.status >= 500 and entry.status <= 599 {
          error_count = 1
        }
        stats[entry.endpoint] = EndpointStats(
          endpoint: entry.endpoint,
          count: 1,
          error_count: error_count,
          latencies: [entry.latency]
        )
      }
    } else {
      total_malformed += 1
    }
  }
}

fn parse_log_line(line: String) -> LogEntry? {
  let parts = line.split(" ")

  // Need at least: CLIENT IDENT USER [TIME] "METHOD TARGET PROTOCOL" STATUS BYTES LATENCY
  if parts.length < 10 {
    return none
  }

  // Check format: CLIENT IDENT USER [TIME...] "..."
  if not parts[0].contains(".") and not parts[0].contains(":") {
    return none  // CLIENT should be IP-like or hostname
  }

  // Find the quoted request part
  var quote_start = -1
  for i in 0..<parts.length {
    if parts[i].starts_with("\"") {
      quote_start = i
      break
    }
  }

  if quote_start == -1 or quote_start < 3 {
    return none
  }

  // Find the closing quote
  var quote_end = -1
  for i in quote_start..<parts.length {
    if parts[i].ends_with("\"") {
      quote_end = i
      break
    }
  }

  if quote_end == -1 {
    return none
  }

  // Extract METHOD TARGET PROTOCOL from quoted part
  let method_str = parts[quote_start].trim_chars("\"").split(" ")
  if method_str.length < 3 {
    return none
  }

  let method = method_str[0]
  let full_target = method_str[1]

  // Validate METHOD
  if not is_valid_method(method) {
    return none
  }

  // Extract TARGET up to ?
  let target = extract_target(full_target)
  if target.is_empty() {
    return none
  }

  let endpoint = "${method} ${target}"

  // Get STATUS, BYTES, LATENCY
  let status_idx = quote_end + 1
  let bytes_idx = quote_end + 2
  let latency_idx = quote_end + 3

  if status_idx >= parts.length or bytes_idx >= parts.length or latency_idx >= parts.length {
    return none
  }

  let status = try parts[status_idx].to_int() catch {
    return none
  }

  if status < 100 or status > 599 {
    return none
  }

  let latency = try parts[latency_idx].to_int() catch {
    return none
  }

  return LogEntry(endpoint: endpoint, status: status, latency: latency)
}

fn is_valid_method(method: String) -> Bool {
  if method.is_empty() {
    return false
  }

  for c in method.chars() {
    let cp = c.code_points()[0]
    if cp < 65 or cp > 90 {  // A-Z
      return false
    }
  }

  return true
}

fn extract_target(target: String) -> String {
  if target.is_empty() {
    return ""
  }

  let qpos = target.index_of("?")
  if qpos is some(pos) {
    return target.slice(0, pos)
  }

  return target
}

fn calculate_error_rate(errors: Int, total: Int) -> String {
  if total == 0 {
    return "0.00"
  }

  let rate = errors.to_float() * 100.0 / total.to_float()
  return rate.format(2)
}

fn calculate_percentile(latencies: List<Int>, percentile: Int) -> Int {
  if latencies.is_empty() {
    return 0
  }

  let sorted = latencies.sorted()
  let n = sorted.length

  // Nearest-rank method: position = ceil(P * n / 100)
  let pos = (percentile * n + 99) / 100  // This is ceil division
  let idx = pos - 1  // Convert to 0-based index

  if idx >= n {
    return sorted[n - 1]
  }

  if idx < 0 {
    return sorted[0]
  }

  return sorted[idx]
}
