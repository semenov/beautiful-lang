import math

type Body {
  x: Float
  y: Float
  z: Float
  vx: Float
  vy: Float
  vz: Float
  mass: Float
}

fn energy(bs: List<Body>) -> Float {
  var e = 0.0
  for i in 0..<bs.length {
    let b = bs[i]
    e += 0.5 * b.mass * (b.vx * b.vx + b.vy * b.vy + b.vz * b.vz)
    for j in (i + 1)..<bs.length {
      let c = bs[j]
      let dx = b.x - c.x
      let dy = b.y - c.y
      let dz = b.z - c.z
      e -= b.mass * c.mass / (dx * dx + dy * dy + dz * dz).sqrt()
    }
  }
  return e
}

fn main() {
  let solar = 4.0 * math.pi() * math.pi()
  let year = 365.24
  var bs = [
    Body(x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, mass: solar),
    Body(x: 4.84143144246472090e+00, y: -1.16032004402742839e+00, z: -1.03622044471123109e-01, vx: 1.66007664274403694e-03 * year, vy: 7.69901118419740425e-03 * year, vz: -6.90460016972063023e-05 * year, mass: 9.54791938424326609e-04 * solar),
    Body(x: 8.34336671824457987e+00, y: 4.12479856412430479e+00, z: -4.03523417114321381e-01, vx: -2.76742510726862411e-03 * year, vy: 4.99852801234917238e-03 * year, vz: 2.30417297573763929e-05 * year, mass: 2.85885980666130812e-04 * solar),
    Body(x: 1.28943695621391310e+01, y: -1.51111514016986312e+01, z: -2.23307578892655734e-01, vx: 2.96460137564761618e-03 * year, vy: 2.37847173959480950e-03 * year, vz: -2.96589568540237556e-05 * year, mass: 4.36624404335156298e-05 * solar),
    Body(x: 1.53796971148509165e+01, y: -2.59193146099879641e+01, z: 1.79258772950371181e-01, vx: 2.68067772490389322e-03 * year, vy: 1.62824170038242295e-03 * year, vz: -9.51592254519715870e-05 * year, mass: 5.15138902046611451e-05 * solar),
  ]
  var px = 0.0
  var py = 0.0
  var pz = 0.0
  for b in bs {
    px += b.vx * b.mass
    py += b.vy * b.mass
    pz += b.vz * b.mass
  }
  bs[0].vx = 0.0 - px / solar
  bs[0].vy = 0.0 - py / solar
  bs[0].vz = 0.0 - pz / solar
  print(energy(bs).format(9))
  let dt = 0.01
  let n = bs.length
  for s in 0..<5_000_000 {
    for i in 0..<n {
      for j in (i + 1)..<n {
        let dx = bs[i].x - bs[j].x
        let dy = bs[i].y - bs[j].y
        let dz = bs[i].z - bs[j].z
        let d2 = dx * dx + dy * dy + dz * dz
        let mag = dt / (d2 * d2.sqrt())
        let mi = bs[i].mass
        let mj = bs[j].mass
        bs[i].vx -= dx * mj * mag
        bs[i].vy -= dy * mj * mag
        bs[i].vz -= dz * mj * mag
        bs[j].vx += dx * mi * mag
        bs[j].vy += dy * mi * mag
        bs[j].vz += dz * mi * mag
      }
    }
    for i in 0..<n {
      bs[i].x += dt * bs[i].vx
      bs[i].y += dt * bs[i].vy
      bs[i].z += dt * bs[i].vz
    }
  }
  print(energy(bs).format(9))
}
