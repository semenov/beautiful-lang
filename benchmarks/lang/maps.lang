type Rng {
  state: Int

  mutating fn next() -> Int {
    var x = self.state
    x = x.bit_xor(x.shift_left(13).bit_and(4294967295))
    x = x.bit_xor(x.shift_right(17))
    x = x.bit_xor(x.shift_left(5).bit_and(4294967295))
    self.state = x
    return x
  }
}

fn main() {
  var rng = Rng(state: 2463534242)
  var total = 0
  for round in 0..<5 {
    var m: Map<Int, Int> = {}
    for i in 0..<2_000_000 {
      let k = rng.next() % 1_000_000
      m[k] = (m[k] ?? 0) + i % 7
    }
    var hits = 0
    for i in 0..<5_000_000 {
      if m[rng.next() % 2_000_000] is some(v) {
        hits += v
      }
    }
    var k = 0
    while k < 1_000_000 {
      m.remove(k)
      k += 2
    }
    total += hits + m.length
  }
  print("${total}")
}
