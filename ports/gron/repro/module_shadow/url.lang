// FIXED (the error names the shadowed module). Was: A project file named like a standard module (url.lang) can't import that
// standard module: "the main file can't be imported". The error should say
// that the file name shadows the standard `url` module.
import url

pub fn host(u: String) throws -> String {
  return (try url.parse(u)).host
}

test "host" {
  expect (try host("https://example.com/x")) == "example.com"
}
