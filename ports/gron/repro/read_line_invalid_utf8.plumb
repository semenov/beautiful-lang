// read_line gives a String that holds bytes that aren't UTF-8 (a\xffb comes
// back as 3 bytes 61 ff 62), but Bytes.text() refuses to make the same
// String ("not valid UTF-8"), so a String can't be cut into pieces by byte
// offsets without changing it. gron's lexer works on line.bytes() and has
// to replace bad bytes with U+FFFD when it makes each token's text; Go
// keeps them, so an error that quotes such a line differs. Run:
//   printf 'a\xffb\n' | plumb run repro/read_line_invalid_utf8.plumb
import io

fn main() throws {
  while try io.read_line() is some(line) {
    print("read_line: ${line.byte_length()} bytes: ${line.bytes().hex()}")
    let again = try line.bytes().text() catch err { "text() failed: ${err.message()}" }
    print(again)
  }
}
