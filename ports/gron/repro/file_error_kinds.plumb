// FIXED (files.NotFound etc.; reading a directory is an error). Was: 1. File errors are only text: there is no NotFound / PermissionDenied /
//    IsADirectory to test with `is`, so a program that words its own
//    messages (gron copies Go's "open x: permission denied") has to match on
//    the text or ask files.exists / files.is_dir again.
// 2. BUG: files.read and files.read_bytes of a directory give empty text,
//    not an error (files.open of the same directory is an error).
// Run: touch /tmp/noperm && chmod 000 /tmp/noperm && plumb run repro/file_error_kinds.plumb
import files

fn main() throws {
  for p in ["/nonexistent", "/tmp/noperm", "/tmp"] {
    let text = try files.read(p) catch err { "error: ${err.message()}" }
    print("read ${p}: [${text}]")
    let size = try files.read_bytes(p).length catch err { -1 }
    print("read_bytes ${p}: ${size}")
    with f = try files.open(p) catch err {
      print("open ${p}: error: ${err.message()}")
      continue
    } {
      print("open ${p}: ok")
    }
  }
}
