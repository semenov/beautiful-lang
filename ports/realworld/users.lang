// Registration, login and the signed-in user: /api/users, /api/user.

import api
import auth
import crypto
import http

type Account {
  id: Int
  username: String
  email: String
  password_hash: String
  bio: String? = none
  image: String? = none
}

// What the API shows of the signed-in user.
type User {
  email: String
  token: String
  username: String
  bio: String?
  image: String?
}

type UserBody {
  user: User
}

type Registration {
  username: String = ""
  email: String = ""
  password: String = ""
}

type RegistrationBody {
  user: Registration
}

type Login {
  email: String = ""
  password: String = ""
}

type LoginBody {
  user: Login
}

type Id {
  id: Int
}

let min_password = 8

fn answer(status: Int, account: Account, app: api.App) -> http.Response {
  let user = User(
    email: account.email,
    token: auth.token(account.id, username: account.username, secret: app.secret),
    username: account.username,
    bio: account.bio,
    image: account.image,
  )
  return api.reply(status, UserBody(user: user))
}

fn check_password(password: String) throws {
  if password.is_empty() {
    throw api.blank("password")
  }
  if password.length < min_password {
    throw api.invalid("password", problem: "is too short (minimum is ${min_password} characters)")
  }
}

fn load(app: api.App, id: Int) throws -> Account {
  let found = try app.conn.query<Account>("select * from users where id = ?", [id])
  return found.first() ?? throw api.unauthorized("is invalid")
}

// A username or email another user already has: a 409.
fn check_free(app: api.App, username: String, email: String, id: Int) throws {
  let same_name = try app.conn.query<Id>("select id from users where username = ? and id != ?", [username, id])
  if not same_name.is_empty() {
    throw api.taken("username")
  }
  let same_email = try app.conn.query<Id>("select id from users where email = ? and id != ?", [email, id])
  if not same_email.is_empty() {
    throw api.taken("email")
  }
}

// POST /api/users
pub fn register(req: http.Request, app: api.App) throws -> http.Response {
  let input = (try api.decode<RegistrationBody>(req)).user
  let username = input.username.trim()
  let email = input.email.trim()
  if username.is_empty() {
    throw api.blank("username")
  }
  if email.is_empty() {
    throw api.blank("email")
  }
  try check_password(input.password)
  let hash = crypto.hash_password(input.password)
  let id = try app.write(() => {
    try check_free(app, username: username, email: email, id: 0)
    try app.conn.insert("insert into users (username, email, password_hash) values (?, ?, ?)", [username, email, hash])
  })
  return answer(201, account: try load(app, id: id), app: app)
}

// POST /api/users/login
pub fn login(req: http.Request, app: api.App) throws -> http.Response {
  let input = (try api.decode<LoginBody>(req)).user
  if input.email.trim().is_empty() {
    throw api.blank("email")
  }
  if input.password.is_empty() {
    throw api.blank("password")
  }
  let found = try app.conn.query<Account>("select * from users where email = ?", [input.email.trim()])
  if found.first() is some(account) and crypto.verify_password(input.password, stored: account.password_hash) {
    return answer(200, account: account, app: app)
  }
  throw api.ApiError(status: 401, field: "credentials", problem: "invalid")
}

// GET /api/user
pub fn current(req: http.Request, app: api.App) throws -> http.Response {
  let id = try auth.require(req, app)
  return answer(200, account: try load(app, id: id), app: app)
}

// PUT /api/user: only the fields given change; bio and image can be
// cleared with null or "".
pub fn update(req: http.Request, app: api.App) throws -> http.Response {
  let id = try auth.require(req, app)
  var account = try load(app, id: id)
  let fields = try api.fields(req, wrapper: "user")
  if fields["username"] is some(v) {
    account.username = (try api.required_text(v, field: "username")).trim()
  }
  if fields["email"] is some(v) {
    account.email = (try api.required_text(v, field: "email")).trim()
  }
  if fields["bio"] is some(v) {
    account.bio = try api.optional_text(v, field: "bio")
  }
  if fields["image"] is some(v) {
    account.image = try api.optional_text(v, field: "image")
  }
  if fields["password"] is some(v) {
    let password = try api.optional_text(v, field: "password") ?? ""
    try check_password(password)
    account.password_hash = crypto.hash_password(password)
  }
  try app.write(() => {
    try check_free(app, username: account.username, email: account.email, id: id)
    try app.conn.execute(
      "update users set username = ?, email = ?, password_hash = ?, bio = ?, image = ? where id = ?",
      [account.username, account.email, account.password_hash, api.nullable(account.bio), api.nullable(account.image), id],
    )
  })
  return answer(200, account: account, app: app)
}
