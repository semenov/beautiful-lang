// Helpers shared by the handlers: request inspection, parsing of user input,
// and small pieces of the Go standard library that lang doesn't have
// (canonical header keys, status texts, HTML escaping, seeded random numbers).

import encoding
import http
import json
import regex
import time
import url

// ---- content types ----

pub fn binary_content_type() -> String {
  return "application/octet-stream"
}

pub fn html_content_type() -> String {
  return "text/html; charset=utf-8"
}

pub fn json_content_type() -> String {
  return "application/json; charset=utf-8"
}

pub fn jsonl_content_type() -> String {
  return "application/x-ndjson; charset=utf-8"
}

pub fn sse_content_type() -> String {
  return "text/event-stream; charset=utf-8"
}

pub fn text_content_type() -> String {
  return "text/plain; charset=utf-8"
}

// ---- responses ----

// JSON as go-httpbin writes it: two-space indent, no HTML escaping, and a
// final newline.
pub fn write_json<T>(status: Int, value: T) -> http.Response {
  return write_response(status, content_type: json_content_type(), body: "${json.encode_pretty(value)}\n".bytes())
}

pub fn write_response(status: Int, content_type: String, body: Bytes) -> http.Response {
  return http.Response(status: status, body: body, headers: {"content-type": content_type})
}

pub fn write_html(status: Int, body: Bytes) -> http.Response {
  return write_response(status, content_type: html_content_type(), body: body)
}

// A response with no body and no content type (Go's bare WriteHeader).
pub fn empty(status: Int) -> http.Response {
  return http.Response(status: status, body: Bytes())
}

type ErrorResponse {
  status_code: Int
  error: String
}

type ErrorDetailResponse {
  status_code: Int
  error: String
  detail: String
}

pub fn write_error(status: Int, detail: String) -> http.Response {
  // `omitempty` doesn't exist: two record types instead
  if detail == "" {
    return write_json(status, ErrorResponse(status_code: status, error: status_text(status)))
  }
  return write_json(status, ErrorDetailResponse(status_code: status, error: status_text(status), detail: detail))
}

